#!/bin/sh
# Apps Android (Waydroid). Opcional: se falhar, o build continua.
. /etc/atriumos-build.conf 2>/dev/null || true
[ "${ANDROID:-1}" = "1" ] || exit 0
export DEBIAN_FRONTEND=noninteractive
ok=0
if curl -fsSL https://repo.waydro.id/waydroid.gpg -o /usr/share/keyrings/waydroid.gpg; then
  echo "deb [signed-by=/usr/share/keyrings/waydroid.gpg] https://repo.waydro.id/ trixie main" > /etc/apt/sources.list.d/waydroid.list
  if apt-get update && apt-get install -y waydroid; then ok=1; fi
fi
if [ "$ok" = 1 ]; then
  echo "AtriumOS: Waydroid instalado"
else
  echo "AVISO: Waydroid não foi instalado; o app Apps Android vai avisar o usuário"
  rm -f /etc/apt/sources.list.d/waydroid.list
  apt-get update || true
fi
apt-get clean
