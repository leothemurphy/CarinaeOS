#!/bin/sh
# AtriumOS: identidade, tela de boot, login, instalador e ajustes do sistema
set -e

# --- nome do sistema ---
cat > /usr/lib/os-release <<'OS'
PRETTY_NAME="AtriumOS 0.1 (Pátio)"
NAME="AtriumOS"
VERSION_ID="0.1"
VERSION="0.1 (Pátio)"
VERSION_CODENAME=trixie
ID=atriumos
ID_LIKE=debian
LOGO=atriumos
HOME_URL="https://github.com/atriumos/atriumos"
SUPPORT_URL="https://github.com/atriumos/atriumos/issues"
BUG_REPORT_URL="https://github.com/atriumos/atriumos/issues"
OS
printf 'AtriumOS 0.1 \\n \\l\n\n' > /etc/issue
echo "AtriumOS 0.1" > /etc/issue.net

# --- GRUB do sistema instalado ---
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/atriumos.cfg <<'GR'
GRUB_DISTRIBUTOR="AtriumOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_TIMEOUT=2
GR

# --- tela de inicialização ---
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme atriumos || true
fi

# --- instalador (Calamares) ---
if [ -f /etc/calamares/settings.conf ]; then
  sed -i -E 's/^([[:space:]]*)branding:.*/\1branding: atriumos/' /etc/calamares/settings.conf
fi
# sem gerenciador de login gráfico: o AtriumOS entra direto na interface
sed -i -E '/^[[:space:]]*-[[:space:]]*displaymanager[[:space:]]*$/d' /etc/calamares/settings.conf 2>/dev/null || true
if [ -f /etc/calamares/modules/partition.conf ]; then
  if grep -q '^defaultFileSystemType' /etc/calamares/modules/partition.conf; then
    sed -i -E 's/^defaultFileSystemType:.*/defaultFileSystemType: "btrfs"/' /etc/calamares/modules/partition.conf
  else
    echo 'defaultFileSystemType: "btrfs"' >> /etc/calamares/modules/partition.conf
  fi
else
  mkdir -p /etc/calamares/modules
  cat > /etc/calamares/modules/partition.conf <<'PC'
efiSystemPartition: "/boot/efi"
userSwapChoices: [ none, small, file ]
defaultFileSystemType: "btrfs"
availableFileSystemTypes: [ "btrfs", "ext4", "xfs" ]
PC
fi

# --- Modo leve: memória comprimida (zram) ---
if [ -f /etc/default/zramswap ]; then
  sed -i -E 's/^#?[[:space:]]*ALGO=.*/ALGO=zstd/; s/^#?[[:space:]]*PERCENT=.*/PERCENT=50/' /etc/default/zramswap
fi

# --- serviços ---
systemctl enable atrium-firstboot.service || true

# --- caches ---
gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

# sudoers do teclado com permissões corretas
chmod 0440 /etc/sudoers.d/atriumos-teclado 2>/dev/null || true

# Calamares: instalar também o carregador EFI no caminho padrão (VirtualBox e PCs que esquecem a entrada de boot)
mkdir -p /etc/calamares/modules
[ -f /etc/calamares/modules/bootloader.conf ] || cp /usr/share/calamares/modules/bootloader.conf /etc/calamares/modules/ 2>/dev/null || true
if [ -f /etc/calamares/modules/bootloader.conf ]; then
  if grep -q '^installEFIFallback' /etc/calamares/modules/bootloader.conf; then
    sed -i -E 's/^installEFIFallback:.*/installEFIFallback: true/' /etc/calamares/modules/bootloader.conf
  else
    echo 'installEFIFallback: true' >> /etc/calamares/modules/bootloader.conf
  fi
fi
# sessão live: grupos para compartilhar pastas e configurar impressoras
mkdir -p /etc/live/config.conf.d
echo 'LIVE_USER_DEFAULT_GROUPS="audio cdrom dip floppy video plugdev netdev powerdev scanner bluetooth sambashare lpadmin"' > /etc/live/config.conf.d/atriumos.conf
# compartilhamento por usuário (pasta Público) com convidados
if [ -f /etc/samba/smb.conf ] && ! grep -q 'usershare allow guests' /etc/samba/smb.conf; then
  sed -i '/^\[global\]/a \   usershare allow guests = yes' /etc/samba/smb.conf
fi
