[Desktop Entry]
Type=Application
Name=Pórtico
GenericName=Navegador
Comment=Navegue com privacidade
Exec=portico %u
Icon=portico
Terminal=false
StartupWMClass=portico
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=internet;web;navegador;browser;
Actions=nova-janela;privada;

[Desktop Action nova-janela]
Name=Nova janela
Exec=portico --new-window

[Desktop Action privada]
Name=Nova janela privada
Exec=portico --private-window
