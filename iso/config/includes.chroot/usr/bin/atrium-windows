#!/bin/sh
# Abre programas do Windows (.exe / .msi) sem mostrar o Wine.
export WINEPREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/atrium/windows"
export WINEDEBUG=-all
if [ ! -d "$WINEPREFIX" ]; then
  notify-send -a "AtriumOS" -i atriumos "Preparando os apps do Windows" "Só na primeira vez. Leva alguns segundos." 2>/dev/null || true
  wineboot -i >/dev/null 2>&1
fi
[ $# -eq 0 ] && exit 0
case "$1" in
  *.msi|*.MSI) exec wine msiexec /i "$1" ;;
  *) exec wine start /unix "$@" ;;
esac
