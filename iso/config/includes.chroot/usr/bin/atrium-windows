#!/bin/sh
# AtriumOS — abre programas do Windows (.exe / .msi) sem mostrar o Wine.
export WINEPREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/atrium/windows"
export WINEDEBUG=-all
# sem perguntas do Wine (Mono/Gecko) na primeira vez
export WINEDLLOVERRIDES="mscoree=;mshtml="
EST="${XDG_RUNTIME_DIR:-/tmp}/atrium-windows"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/atriumos/windows.log"
mkdir -p "$(dirname "$LOG")" "$(dirname "$WINEPREFIX")"
if [ ! -f "$WINEPREFIX/system.reg" ]; then
  echo preparando > "$EST"
  echo "== preparando o ambiente Windows $(date)" >>"$LOG"
  if ! wineboot -i >>"$LOG" 2>&1; then echo erro > "$EST"; exit 1; fi
  wineserver -w 2>/dev/null
fi
[ $# -eq 0 ] && { echo pronto > "$EST"; exit 0; }
echo abrindo > "$EST"
echo "== abrindo $1 $(date)" >>"$LOG"
cd "$(dirname "$1")" || exit 1
case "$1" in
  *.msi|*.MSI) wine msiexec /i "$1" >>"$LOG" 2>&1 & ;;
  *) wine "$1" >>"$LOG" 2>&1 & ;;
esac
P=$!
sleep 8
if kill -0 $P 2>/dev/null; then echo aberto > "$EST"; else wait $P; R=$?; [ $R -eq 0 ] && echo aberto > "$EST" || echo "erro:$R" > "$EST"; fi
wait $P 2>/dev/null
