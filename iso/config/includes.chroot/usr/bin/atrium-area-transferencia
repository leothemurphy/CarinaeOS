#!/bin/sh
# AtriumOS — o texto copiado não se perde quando o programa que copiou é fechado.
F="${XDG_RUNTIME_DIR:-/tmp}/atrium-area-transferencia"
export F
exec wl-paste --type text --watch sh -c '
  case "${CLIPBOARD_STATE:-data}" in
    nil|clear) [ -s "$F" ] && wl-copy --type text/plain < "$F" ;;
    sensitive) cat >/dev/null ;;
    *) T="$F.novo"; cat > "$T"; if [ -s "$T" ]; then mv "$T" "$F"; chmod 600 "$F"; else rm -f "$T"; fi ;;
  esac'
