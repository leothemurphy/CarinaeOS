#!/bin/sh
# Apps Android (Waydroid). Na primeira vez, baixa o sistema Android.
if ! command -v waydroid >/dev/null 2>&1; then
  kdialog --title "Apps Android" --error "Os Apps Android não vieram nesta versão do AtriumOS." 2>/dev/null
  exit 1
fi
if [ ! -e /var/lib/waydroid/images/system.img ]; then
  kdialog --title "Apps Android" --yesno "Para usar apps Android, o AtriumOS vai baixar o sistema Android (cerca de 1 GB), com a Google Play.\n\nContinuar?" 2>/dev/null || exit 0
  pkexec waydroid init -s GAPPS -f || { kdialog --title "Apps Android" --error "Não foi possível baixar o Android. Verifique a internet e tente de novo." 2>/dev/null; exit 1; }
fi
waydroid session start >/dev/null 2>&1 &
sleep 6
exec waydroid show-full-ui
