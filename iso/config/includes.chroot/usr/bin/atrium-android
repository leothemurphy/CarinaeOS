#!/bin/sh
# AtriumOS — Apps Android (Waydroid + loja Aurora, que instala apps da Google Play)
# Estado em $XDG_RUNTIME_DIR/atrium-android (lido pela interface)
ST="${XDG_RUNTIME_DIR:-/tmp}/atrium-android"
s(){ echo "$1" > "$ST"; }
if ! command -v waydroid >/dev/null 2>&1; then s "sem-android"; exit 1; fi
if [ ! -e /var/lib/waydroid/waydroid.cfg ]; then
  s "preparando"
  systemctl start atrium-android-init.service || { s "erro-preparar"; exit 1; }
fi
s "abrindo"
systemctl start waydroid-container.service 2>/dev/null || true
waydroid session start >/dev/null 2>&1 &
i=0
while [ $i -lt 90 ] && ! waydroid status 2>/dev/null | grep -q "Session:.*RUNNING"; do sleep 2; i=$((i+1)); done
APK=/var/lib/atriumos/aurora-store.apk
if [ -f "$APK" ] && ! waydroid app list 2>/dev/null | grep -q com.aurora.store; then
  waydroid app install "$APK" >/dev/null 2>&1 || true
fi
s "pronto"
if [ -n "$1" ]; then
  exec waydroid app install "$1"
fi
waydroid app launch com.aurora.store >/dev/null 2>&1 || exec waydroid show-full-ui
