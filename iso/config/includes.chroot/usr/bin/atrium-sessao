#!/bin/sh
# AtriumOS — inicia a sessão: gerenciador de janelas (labwc) com a interface
# do AtriumOS no fundo e os apps de verdade abrindo em janelas por cima.
# Vídeo: em máquina virtual usa o modo de compatibilidade (desenho pelo
# processador). Para forçar: /etc/atriumos/video = compatibilidade | aceleracao
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/labwc"
ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/atriumos"
mkdir -p "$CFG" "$ESTADO"
LOG="$ESTADO/sessao.log"
: > "$LOG"

MODO="$(cat /etc/atriumos/video 2>/dev/null)"
if [ -z "$MODO" ]; then
  if systemd-detect-virt -q || [ ! -e /dev/dri/card0 ]; then MODO=compatibilidade; else MODO=aceleracao; fi
fi
echo "== vídeo: $MODO ($(systemd-detect-virt 2>/dev/null))" >>"$LOG"

# teclado igual ao do sistema
[ -f /etc/default/keyboard ] && . /etc/default/keyboard
# escolha do usuário (Ajustes › Teclado) vale mais
[ -f "$HOME/.config/atriumos/teclado" ] && . "$HOME/.config/atriumos/teclado"

# espaço reservado para a Dock (Ajustes › Dock pode mudar)
ATRIUM_MARGEM_BAIXO="$(cat "$HOME/.config/atriumos/margem-dock" 2>/dev/null || echo 84)"

# tirar a barra da janela da interface (o comando mudou na versão 0.8 do labwc)
V="$(labwc --version 2>/dev/null | grep -o '[0-9]*\.[0-9]*' | head -1)"
case "$V" in
  0.[0-7]) SEMBARRA='<action name="ToggleDecorations"/>' ;;
  *)       SEMBARRA='<action name="SetDecorations" decorations="none"/>' ;;
esac

cat > "$CFG/rc.xml" <<X
<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration><gap>0</gap></core>
  <theme>
    <name>AtriumOS</name>
    <cornerRadius>10</cornerRadius>
    <titlebar><layout>close,iconify,max:</layout><showTitle>yes</showTitle></titlebar>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>
  <!-- a barra de menus e a Dock da interface ficam sempre visíveis: janelas maximizadas não as cobrem -->
  <margin top="30" bottom="${ATRIUM_MARGEM_BAIXO:-84}"/>
  <placement><policy>center</policy></placement>
  <keyboard><default/>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <!--ATALHOS-->$(cat "$HOME/.config/atriumos/atalhos.xml" 2>/dev/null)<!--/ATALHOS-->
  </keyboard>
  <windowRules>
    <windowRule identifier="*127.0.0.1*" skipTaskbar="yes" skipWindowSwitcher="yes">
      $SEMBARRA
      <action name="ToggleFullscreen"/>
      <action name="ToggleAlwaysOnBottom"/>
    </windowRule>
  </windowRules>
</labwc_config>
X

{
  if [ -f "$HOME/.config/atriumos/idioma" ]; then
    L="$(cat "$HOME/.config/atriumos/idioma")"; echo "LANG=$L.UTF-8"; echo "LANGUAGE=$L:${L%%_*}"
  fi
  echo "XKB_DEFAULT_LAYOUT=${XKBLAYOUT:-pt}"
  [ -n "$XKBVARIANT" ] && echo "XKB_DEFAULT_VARIANT=$XKBVARIANT"
  echo "WLR_NO_HARDWARE_CURSORS=1"
  echo "XCURSOR_THEME=Adwaita"
  echo "MOZ_ENABLE_WAYLAND=1"
  echo "QT_QPA_PLATFORM=wayland;xcb"
  echo "ATRIUM_VIDEO=$MODO"
  [ "$MODO" = compatibilidade ] && echo "WLR_RENDERER=pixman"
} > "$CFG/environment"

printf '%s\n' "atrium-area-transferencia &" "atrium-interface &" "atrium-players &" > "$CFG/autostart"

[ "$MODO" = compatibilidade ] && export WLR_RENDERER=pixman
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=AtriumOS:wlroots
exec labwc >>"$LOG" 2>&1
