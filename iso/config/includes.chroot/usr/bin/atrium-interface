#!/bin/sh
# AtriumOS — mantém a interface aberta no fundo da tela.
# Vigia: se a interface não carregar em 2 minutos, reabre; se fechar, reabre.
ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/atriumos"
mkdir -p "$ESTADO"
LOG="$ESTADO/interface.log"
OK="${XDG_RUNTIME_DIR:-/tmp}/atrium-interface-ok"
DADOS="${XDG_DATA_HOME:-$HOME/.local/share}/atriumos/interface"
mkdir -p "$DADOS/Default"

xdg-user-dirs-update >/dev/null 2>&1 || true

if ! curl -s -o /dev/null http://127.0.0.1:7777/; then
  python3 /usr/lib/atriumos/shell-server.py >>"$LOG" 2>&1 &
  i=0
  while [ $i -lt 30 ] && ! curl -s -o /dev/null http://127.0.0.1:7777/; do sleep 0.3; i=$((i+1)); done
fi

EXTRA=""
URL="http://127.0.0.1:7777/"
# em máquina virtual / sem placa de vídeo: interface leve (sem desfoque, que pesa muito sem GPU)
[ "$ATRIUM_VIDEO" = compatibilidade ] && EXTRA="--disable-gpu --disable-gpu-compositing" && URL="http://127.0.0.1:7777/?leve=1"

while true; do
  # janela sem barra própria do Chromium (a do sistema é removida pela regra do labwc)
  [ -f "$DADOS/Default/Preferences" ] || echo '{"browser":{"custom_chrome_frame":false},"translate":{"enabled":false}}' > "$DADOS/Default/Preferences"
  rm -f "$OK"
  # shellcheck disable=SC2086
  chromium --app="$URL" --ozone-platform=wayland --user-data-dir="$DADOS" \
    --no-first-run --no-default-browser-check --password-store=basic --noerrdialogs \
    --disable-features=Translate --disable-session-crashed-bubble \
    --autoplay-policy=no-user-gesture-required $EXTRA >>"$LOG" 2>&1 &
  PID=$!
  i=0
  while [ $i -lt 120 ] && [ ! -f "$OK" ] && kill -0 $PID 2>/dev/null; do sleep 1; i=$((i+1)); done
  if [ -f "$OK" ]; then
    echo "== interface carregou em ${i}s" >>"$LOG"
    wait $PID
    echo "== interface fechou; reabrindo" >>"$LOG"
  else
    echo "== interface não carregou; reabrindo" >>"$LOG"
    kill $PID 2>/dev/null; sleep 2; kill -9 $PID 2>/dev/null
  fi
  sleep 1
done
