#!/bin/sh
# AtriumOS — ajustes do sistema pedidos pela configuração inicial (executado com sudo, só estes comandos).
#   conta "<nome completo>" "<nome-do-computador>"   (a senha nova vem pela entrada padrão)
#   idioma <pt_BR|pt_PT|en_US|es_ES|fr_FR|de_DE|it_IT>
set -e
U="${SUDO_USER:-}"
[ -n "$U" ] && [ "$U" != root ] || exit 1
MARCA=/var/lib/atriumos/conta-configurada
case "$1" in
  conta)
    # só uma vez (configuração inicial); depois a senha muda pelos Ajustes pedindo a senha atual
    [ -f "$MARCA" ] && { echo "já configurado" >&2; exit 3; }
    NOME="$(printf '%s' "$2" | tr -d ':,=\n' | cut -c1-60)"
    HOST="$(printf '%s' "$3" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-' | cut -c1-40)"
    [ -n "$NOME" ] && usermod -c "$NOME" "$U"
    IFS= read -r SENHA || true
    if [ -n "$SENHA" ]; then printf '%s:%s\n' "$U" "$SENHA" | chpasswd; fi
    if [ -n "$HOST" ]; then
      ANT="$(hostname)"
      hostnamectl set-hostname "$HOST" 2>/dev/null || { echo "$HOST" > /etc/hostname; hostname "$HOST"; }
      sed -i "s/\b$ANT\b/$HOST/g" /etc/hosts 2>/dev/null || true
      grep -q "127.0.1.1" /etc/hosts || echo "127.0.1.1 $HOST" >> /etc/hosts
    fi
    # sessão pela ISO: não marca, para a próxima sessão também configurar
    [ -d /run/live/medium ] || { mkdir -p /var/lib/atriumos; touch "$MARCA"; }
    ;;
  idioma)
    case "$2" in pt_BR|pt_PT|en_US|es_ES|fr_FR|de_DE|it_IT) ;; *) exit 1;; esac
    localectl set-locale "LANG=$2.UTF-8" 2>/dev/null || echo "LANG=$2.UTF-8" > /etc/default/locale
    ;;
  drivers)
    shift
    for p in "$@"; do case "$p" in *[!a-z0-9.+-]*|"") exit 1;; esac; done
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -q || true
    apt-get install -y -q "$@"
    ;;
  chrome)
    # Google Chrome oficial, baixado do Google (com o repositório de atualizações dele)
    export DEBIAN_FRONTEND=noninteractive
    T="$(mktemp -d)"
    curl -fsSL -o "$T/chrome.deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    apt-get install -y -q "$T/chrome.deb"
    rm -rf "$T"
    ;;
  *) exit 1 ;;
esac
