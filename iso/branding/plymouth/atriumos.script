# AtriumOS — tela de inicialização (Plymouth)
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(cx - logo.image.GetWidth() / 2);
logo.sprite.SetY(cy - logo.image.GetHeight() / 2 - 50);

bg.image = Image("bar-bg.png");
bg.sprite = Sprite(bg.image);
bg.sprite.SetX(cx - bg.image.GetWidth() / 2);
bg.sprite.SetY(cy + 90);

bar.original = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetX(cx - bg.image.GetWidth() / 2);
bar.sprite.SetY(cy + 90);
bar.sprite.SetZ(2);

fun progress_callback(duration, progress) {
  w = Math.Int(bar.original.GetWidth() * progress);
  if (w < 1) w = 1;
  bar.sprite.SetImage(bar.original.Scale(w, bar.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- senha do disco criptografado ---
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
entry.sprite = Sprite();
bullets = [];

fun display_password_callback(prompt_text, count) {
  label = Image.Text("Senha do disco", 1, 1, 1);
  prompt.sprite.SetImage(label);
  prompt.sprite.SetPosition(cx - label.GetWidth() / 2, cy + 130, 10);
  entry.sprite.SetImage(entry.image);
  entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, cy + 155, 10);
  for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
  for (i = 0; i < count && i < 18; i++) {
    if (!bullets[i]) bullets[i] = Sprite(bullet.image);
    bullets[i].SetPosition(cx - entry.image.GetWidth() / 2 + 18 + i * 15, cy + 155 + 15, 11);
    bullets[i].SetOpacity(1);
  }
  bg.sprite.SetOpacity(0); bar.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  prompt.sprite.SetOpacity(0); entry.sprite.SetOpacity(0);
  for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
  bg.sprite.SetOpacity(1); bar.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

msg.sprite = Sprite();
fun message_callback(text) {
  t = Image.Text(text, 0.7, 0.7, 0.7);
  msg.sprite.SetImage(t);
  msg.sprite.SetPosition(cx - t.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);
