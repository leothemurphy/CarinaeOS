#!/bin/sh
# AtriumOS 0.1 "Pátio" — configuração do live-build (Debian 13 trixie)
set -e
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architecture amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --binary-images iso-hybrid \
  --bootloaders "syslinux,grub-efi" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --memtest none \
  --chroot-squashfs-compression-type xz \
  --iso-application "AtriumOS" \
  --iso-publisher "AtriumOS" \
  --iso-volume "AtriumOS 0.1" \
  --image-name "atriumos-0.1" \
  --bootappend-live "boot=live components quiet splash locales=pt_PT.UTF-8 keyboard-layouts=pt timezone=Europe/Lisbon username=atrium hostname=atriumos user-fullname=AtriumOS" \
  "${@}"
