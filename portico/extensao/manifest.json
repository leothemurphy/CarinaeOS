{
  "manifest_version": 2,
  "name": "Pórtico",
  "version": "0.1.0",
  "description": "Página de nova aba e cores do Pórtico (navegador do AtriumOS).",
  "icons": {"48": "icon-48.png", "128": "icon-128.png"},
  "browser_specific_settings": {"gecko": {"id": "portico@atriumos.org", "strict_min_version": "128.0"}, "gecko_android": {"strict_min_version": "128.0"}},
  "chrome_url_overrides": {"newtab": "inicio.html"},
  "chrome_settings_overrides": {"homepage": "inicio.html"},
  "permissions": ["theme"],
  "background": {"scripts": ["tema.js"]}
}
