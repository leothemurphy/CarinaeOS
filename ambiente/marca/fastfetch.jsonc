// CarinaeOS - fastfetch com a estrela e as informações do CarinaeOS
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/carinaeos/marca/fastfetch-logo.ans",
    "width": 44,
    "height": 21,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;215", "title": "38;5;230" },
    "key": { "width": 14 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;5;204m✦ CarinaeOS 1.0" },
    "break",
    { "type": "os", "key": "Sistema", "format": "{pretty-name} {arch}" },
    { "type": "command", "key": "Núcleo", "text": "uname -r | sed -E 's/\\+deb[0-9]+//; s/-amd64//; s/^/Linux /'" },
    { "type": "host", "key": "Computador" },
    { "type": "uptime", "key": "Ligado há" },
    { "type": "packages", "key": "Programas" },
    { "type": "de", "key": "Ambiente" },
    { "type": "wm", "key": "Janelas" },
    { "type": "display", "key": "Tela" },
    { "type": "command", "key": "Terminal", "text": "if [ -n \"$KONSOLE_VERSION\" ]; then echo 'Terminal Carinae'; else basename \"$(ps -o comm= -p $(ps -o ppid= -p $PPID) 2>/dev/null || echo $TERM)\"; fi" },
    "break",
    { "type": "cpu", "key": "Processador" },
    { "type": "gpu", "key": "Vídeo" },
    { "type": "memory", "key": "Memória" },
    { "type": "disk", "key": "Disco", "folders": "/" },
    { "type": "battery", "key": "Bateria" },
    { "type": "localip", "key": "Rede" },
    "break",
    "colors"
  ]
}
