#!/bin/sh
# CarinaeOS - ultimos acertos dentro da imagem (corre no chroot do live-build)
set -e

# ---- identidade do sistema ----------------------------------------------------
# o /usr/lib/os-release e do pacote base-files: desviado para nao voltar a ser
# "Debian" numa atualizacao
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<'EOT'
PRETTY_NAME="CarinaeOS 1.0 (Eta)"
NAME="CarinaeOS"
VERSION_ID="1.0"
VERSION="1.0 (Eta)"
VERSION_CODENAME=trixie
ID=carinaeos
ID_LIKE=debian
LOGO=carinaeos
HOME_URL="https://github.com/leothemurphy/atriumos"
SUPPORT_URL="https://github.com/leothemurphy/atriumos/issues"
BUG_REPORT_URL="https://github.com/leothemurphy/atriumos/issues"
EOT
ln -sf ../usr/lib/os-release /etc/os-release
echo 'CarinaeOS 1.0 \n \l' > /etc/issue
echo 'CarinaeOS 1.0' > /etc/issue.net

# ---- sem o "Centro de boas-vindas" do KDE (mascote Konqi) -------------------
apt-get purge -y plasma-welcome || true

# ---- lancador em ecra inteiro ("Application Dashboard"): o Debian traz o codigo
# no applet kicker, mas nao a entrada org.kde.plasma.kickerdash ------------------
K=/usr/share/plasma/plasmoids/org.kde.plasma.kickerdash
if [ ! -e $K/metadata.json ]; then
  mkdir -p $K
  cat > $K/metadata.json <<'EOT'
{
    "KPackageStructure": "Plasma/Applet",
    "KPlugin": {
        "Authors": [ { "Name": "Eike Hein" } ],
        "Category": "Application Launchers",
        "Description": "Aplicações em ecrã inteiro",
        "Icon": "carinaeos-estrela",
        "Id": "org.kde.plasma.kickerdash",
        "License": "GPL-2.0+",
        "Name": "Aplicações"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-Provides": [ "org.kde.plasma.launchermenu" ],
    "X-Plasma-RootPath": "org.kde.plasma.kicker"
}
EOT
fi

# ---- tema de icones "CarinaeOS": igual ao Breeze escuro, mas com a estrela no
# lugar dos logotipos do KDE e do Debian (menus, "Sobre", instalador...) --------
I=/usr/share/icons/CarinaeOS
mkdir -p $I/scalable/apps $I/scalable/places
cat > $I/index.theme <<'EOT'
[Icon Theme]
Name=CarinaeOS
Comment=Breeze escuro com os logotipos do CarinaeOS
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
EOT
E=/usr/share/icons/hicolor/scalable/apps/carinaeos.svg
S=/usr/share/icons/hicolor/scalable/apps/carinaeos-estrela.svg
for n in start-here start-here-kde start-here-kde-plasma start-here-kde-symbolic start-here-symbolic \
         start-here-debian distributor-logo distributor-logo-debian debian-logo emblem-debian \
         kde plasma kde-symbolic plasma-symbolic; do
  ln -sf $S $I/scalable/places/$n.svg
done
for n in distributor-logo distributor-logo-debian debian-logo install-debian kde plasma \
         org.kde.plasma.kickerdash org.kde.plasma.kickoff org.kde.plasma.kicker; do
  ln -sf $E $I/scalable/apps/$n.svg
done
gtk-update-icon-cache -qtf $I || true

# ---- icones, letras ---------------------------------------------------------------
gtk-update-icon-cache -qtf /usr/share/icons/hicolor || true
fc-cache -f >/dev/null 2>&1 || true

# ---- explorador de arquivos: "Arquivos" (o programa continua a ser o Dolphin) ----
mkdir -p /usr/local/share/applications
sed -E '/^(Name|GenericName)(\[[^]]*\])?=/d' /usr/share/applications/org.kde.dolphin.desktop \
  | sed '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nName=Arquivos\nGenericName=Gerenciador de arquivos/' \
  > /usr/local/share/applications/org.kde.dolphin.desktop

# ---- instalador --------------------------------------------------------------------
sed -i 's/^branding: .*/branding: carinaeos/' /etc/calamares/settings.conf
for f in /usr/share/applications/calamares-install-debian.desktop /etc/xdg/autostart/calamares-desktop-icon.desktop; do
  [ -f "$f" ] || continue
  sed -i -E 's/^Name=.*/Name=Instalar o CarinaeOS/; s/^Icon=.*/Icon=carinaeos/; /^Name\[/d' "$f"
done

# ---- ecra de arranque (Plymouth) ------------------------------------------------
plymouth-set-default-theme carinaeos
update-initramfs -u -k all

# ---- menu de arranque do sistema instalado ----------------------------------------
# (o update-grub so corre depois da instalacao; aqui fica a configuracao pronta)
true
