#!/bin/sh
# CarinaeOS - ultimos acertos dentro da imagem (corre no chroot do live-build)
set -e

# ---- identidade do sistema ----------------------------------------------------
# o /usr/lib/os-release e do pacote base-files: desviado para nao voltar a ser
# "Debian" numa atualizacao
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<'EOT'
PRETTY_NAME="CarinaeOS 1.0 (Eta)"
NAME="CarinaeOS"
VERSION_ID="1.0"
VERSION="1.0 (Eta)"
VERSION_CODENAME=trixie
ID=carinaeos
ID_LIKE=debian
LOGO=carinaeos
HOME_URL="https://github.com/leothemurphy/carinaeos"
SUPPORT_URL="https://github.com/leothemurphy/carinaeos/issues"
BUG_REPORT_URL="https://github.com/leothemurphy/carinaeos/issues"
EOT
ln -sf ../usr/lib/os-release /etc/os-release
# a copia em /etc tambem fica desviada (atualizacoes do base-files nao a trocam)
cat > /etc/lsb-release <<'EOT'
DISTRIB_ID=CarinaeOS
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=eta
DISTRIB_DESCRIPTION="CarinaeOS 1.0 (Eta)"
EOT

# ---- nenhum logotipo do Debian: o "Sobre este sistema" (KDE), o GNOME, o XFCE ----
# o desktop-base (do Debian) traz o seu /etc/xdg/kcm-about-distrorc (logo Debian, "versao 13"):
# desviado, para que nem as atualizacoes o tragam de volta.
dpkg-divert --quiet --local --rename --divert /etc/xdg/kcm-about-distrorc.debian --add /etc/xdg/kcm-about-distrorc
cat > /etc/xdg/kcm-about-distrorc <<'EOT'
[General]
LogoPath=/usr/share/carinaeos/marca/logo-256.png
Website=https://github.com/leothemurphy/carinaeos
Version=1.0 (Eta)
Variant=Edição Plasma
EOT
# logotipos do desktop-base e emblemas "debian": desviados e trocados pelos do CarinaeOS
M=/usr/share/carinaeos/marca
for f in /usr/share/desktop-base/debian-logos/*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  dpkg-divert --quiet --local --rename --divert "$f.debian" --add "$f"
  [ -e "$M/$n" ] && ln -sf "$M/$n" "$f" || ln -sf "$M/logo-256.png" "$f"
done
for f in $(find /usr/share/icons /usr/share/pixmaps -iname '*debian*' \( -name '*.png' -o -name '*.svg' -o -name '*.xpm' \) 2>/dev/null); do
  case "$f" in *.debian) continue ;; esac
  dpkg-divert --quiet --local --rename --divert "$f.debian" --add "$f" || continue
  case "$f" in
    *.svg) ln -sf "$M/logo.svg" "$f" ;;
    *) ln -sf "$M/logo-128.png" "$f" ;;
  esac
done
# alternativas do desktop-base (logotipos do fornecedor e fundo do GRUB) apontam para o CarinaeOS
update-alternatives --install /usr/share/images/vendor-logos vendor-logos $M 1000 || true
update-alternatives --set vendor-logos $M || true
for n in 64 128 256; do
  update-alternatives --install /usr/share/icons/hicolor/${n}x${n}/emblems/emblem-vendor.png emblem-vendor-$n $M/logo-$n.png 1000 2>/dev/null || true
done
update-alternatives --install /usr/share/icons/hicolor/scalable/emblems/emblem-vendor.svg emblem-vendor-scalable $M/logo.svg 1000 2>/dev/null || true
update-alternatives --install /usr/share/images/desktop-base/desktop-grub.png desktop-grub /usr/share/carinaeos/grub.png 1000 2>/dev/null || true
update-alternatives --set desktop-grub /usr/share/carinaeos/grub.png 2>/dev/null || true

echo 'CarinaeOS 1.0 \n \l' > /etc/issue
echo 'CarinaeOS 1.0' > /etc/issue.net

# ---- sem o "Centro de boas-vindas" do KDE (mascote Konqi) -------------------
apt-get purge -y plasma-welcome || true

# ---- lancador em ecra inteiro ("Application Dashboard"): o Debian traz o codigo
# no applet kicker, mas nao a entrada org.kde.plasma.kickerdash ------------------
K=/usr/share/plasma/plasmoids/org.kde.plasma.kickerdash
if [ ! -e $K/metadata.json ]; then
  mkdir -p $K
  cat > $K/metadata.json <<'EOT'
{
    "KPackageStructure": "Plasma/Applet",
    "KPlugin": {
        "Authors": [ { "Name": "Eike Hein" } ],
        "Category": "Application Launchers",
        "Description": "Aplicações em ecrã inteiro",
        "Icon": "carinaeos-estrela",
        "Id": "org.kde.plasma.kickerdash",
        "License": "GPL-2.0+",
        "Name": "Aplicações"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-Provides": [ "org.kde.plasma.launchermenu" ],
    "X-Plasma-RootPath": "org.kde.plasma.kicker"
}
EOT
fi

# ---- tema de icones "CarinaeOS": igual ao Breeze escuro, mas com a estrela no
# lugar dos logotipos do KDE e do Debian (menus, "Sobre", instalador...) --------
I=/usr/share/icons/CarinaeOS
mkdir -p $I/scalable/apps $I/scalable/places
cat > $I/index.theme <<'EOT'
[Icon Theme]
Name=CarinaeOS
Comment=Breeze escuro com os logotipos do CarinaeOS
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Places
EOT
E=/usr/share/icons/hicolor/scalable/apps/carinaeos.svg
S=/usr/share/icons/hicolor/scalable/apps/carinaeos-estrela.svg
for n in start-here start-here-kde start-here-kde-plasma start-here-kde-symbolic start-here-symbolic \
         start-here-debian distributor-logo distributor-logo-debian debian-logo emblem-debian emblem-vendor debian-swirl \
         kde plasma kde-symbolic plasma-symbolic; do
  ln -sf $S $I/scalable/places/$n.svg
done
for n in distributor-logo distributor-logo-debian debian-logo install-debian kde plasma \
         org.kde.plasma.kickerdash org.kde.plasma.kickoff org.kde.plasma.kicker; do
  ln -sf $E $I/scalable/apps/$n.svg
done
# visual "Vidro": os icones coloridos (WhiteSur) por baixo dos do CarinaeOS
if [ -d /usr/share/icons/WhiteSur-dark ]; then
  sed -i 's/^Inherits=.*/Inherits=WhiteSur-dark,breeze-dark,breeze,hicolor/; s/^Comment=.*/Comment=Icones coloridos com os logotipos do CarinaeOS/' $I/index.theme
fi
# Arquivos (Dolphin, Nautilus, Thunar): icone proprio
A=/usr/share/icons/hicolor/scalable/apps/carinaeos-arquivos.svg
for n in system-file-manager file-manager org.kde.dolphin dolphin nautilus org.gnome.Nautilus thunar org.xfce.thunar; do
  ln -sf $A $I/scalable/apps/$n.svg
done
sed -i 's/^Icon=.*/Icon=carinaeos-arquivos/' /usr/local/share/applications/org.kde.dolphin.desktop 2>/dev/null || true
gtk-update-icon-cache -qtf $I || true
for t in WhiteSur WhiteSur-dark WhiteSur-light; do
  [ -d /usr/share/icons/$t ] && gtk-update-icon-cache -qtf /usr/share/icons/$t || true
done

# ---- icones, letras ---------------------------------------------------------------
gtk-update-icon-cache -qtf /usr/share/icons/hicolor || true
update-mime-database /usr/share/mime || true
fc-cache -f >/dev/null 2>&1 || true

# ---- explorador de arquivos: "Arquivos" (o programa continua a ser o Dolphin) ----
mkdir -p /usr/local/share/applications
sed -E '/^(Name|GenericName)(\[[^]]*\])?=/d' /usr/share/applications/org.kde.dolphin.desktop \
  | sed '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nName=Arquivos\nGenericName=Gerenciador de arquivos/' \
  > /usr/local/share/applications/org.kde.dolphin.desktop

# Mapas (Marble) e Calendario (Merkuro): nomes simples, em portugues
renomear() {   # renomear <arquivo.desktop> <Nome> <Descricao>
    [ -f "/usr/share/applications/$1" ] || return 0
    sed -E '/^(Name|GenericName)(\[[^]]*\])?=/d' "/usr/share/applications/$1" \
      | sed "0,/^\[Desktop Entry\]\$/s//[Desktop Entry]\nName=$2\nGenericName=$3/" \
      > "/usr/local/share/applications/$1"
}
sed -i 's/^Icon=.*/Icon=carinaeos-arquivos/' /usr/local/share/applications/org.kde.dolphin.desktop
renomear org.kde.marble.desktop "Mapas" "Mapas e globo terrestre"
renomear org.kde.merkuro.calendar.desktop "Calendário" "Agenda, com a conta Google"
renomear org.kde.merkuro.contact.desktop "Contactos" "Os seus contactos"

# Eta: voz natural (Piper). Se nao der (sem internet), fica a voz do espeak-ng.
pip install --break-system-packages --no-cache-dir --quiet piper-tts \
  || echo "AVISO: Piper nao instalado; a Eta usa o espeak-ng"

# ---- senhas simples: um PIN de 4 a 6 numeros basta para entrar no sistema -------
sed -i -E 's/(pam_unix\.so) obscure /\1 minlen=4 /' /etc/pam.d/common-password
python3 - <<'EOT'
import re
p = '/etc/calamares/modules/users.conf'
s = open(p).read()
s = re.sub(r'passwordRequirements:.*?(?=\n\S|\Z)', """passwordRequirements:
    nonempty: true
    minLength: 4
    maxLength: -1
allowWeakPasswords: true
allowWeakPasswordsDefault: true""", s, flags=re.S)
open(p, 'w').write(s)
EOT

# ---- instalador --------------------------------------------------------------------
sed -i 's/^branding: .*/branding: carinaeos/' /etc/calamares/settings.conf
for f in /usr/share/applications/calamares-install-debian.desktop /etc/xdg/autostart/calamares-desktop-icon.desktop; do
  [ -f "$f" ] || continue
  sed -i -E 's/^Name=.*/Name=Instalar o CarinaeOS/; s/^Icon=.*/Icon=carinaeos/; /^Name\[/d' "$f"
done

# ---- loja Orbita: Flathub ja configurado, com o catalogo (nomes e icones) ----
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
flatpak update --appstream flathub || true

# ---- Ceu vivo: servico do utilizador (desligado ate ser ligado no Supernova) ---
chmod 755 /usr/bin/carinaeos-* || true

# Busca como o Spotlight: Ctrl+Espaco abre o KRunner (o kglobalaccel le os atalhos
# padrao do ficheiro .desktop em /usr/share/kglobalaccel)
for K in /usr/share/kglobalaccel/org.kde.krunner.desktop /usr/share/applications/org.kde.krunner.desktop; do
    [ -f "$K" ] || continue
    if grep -q '^X-KDE-Shortcuts=' "$K"; then
        # so o primeiro (a acao principal); "RunClipboard" mantem Alt+Shift+F2
        sed -i '0,/^X-KDE-Shortcuts=.*/s//X-KDE-Shortcuts=Ctrl+Space,Alt+Space,Alt+F2,Search/' "$K"
    else
        sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nX-KDE-Shortcuts=Ctrl+Space,Alt+Space,Alt+F2,Search/' "$K"
    fi
done

# ---- loja do KDE (Discover) fora dos menus: o CarinaeOS tem a Orbita e a Eta -----------
for f in org.kde.discover.desktop org.kde.discover.urlhandler.desktop; do
  [ -f /usr/share/applications/$f ] || continue
  grep -v '^NoDisplay=' /usr/share/applications/$f | sed '0,/^\[Desktop Entry\]$/s//[Desktop Entry]\nNoDisplay=true/' > /usr/local/share/applications/$f
done

# ---- sessao sem rastro (convidado): criada no primeiro arranque do sistema instalado ----
cat > /etc/systemd/system/carinaeos-convidado.service <<'EOT'
[Unit]
Description=CarinaeOS - conta de convidado (sessao sem rastro)
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/etc/carinaeos/convidado-criado
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/lib/carinaeos/convidado ligar && mkdir -p /etc/carinaeos && touch /etc/carinaeos/convidado-criado'
[Install]
WantedBy=multi-user.target
EOT
systemctl enable carinaeos-convidado.service || true
systemctl --global enable carinaeos-calendarios.timer 2>/dev/null || true
# a pasta pessoal do convidado vive na memoria (montada ao entrar, apagada ao sair) e entra sem senha
for P in /etc/pam.d/sddm /etc/pam.d/gdm-password /etc/pam.d/lightdm; do
  [ -f "$P" ] || continue
  grep -q carinaeos/convidado "$P" && continue
  sed -i '0,/^auth/s//auth    sufficient pam_succeed_if.so user = convidado quiet\nauth/' "$P"
  if grep -qE '^(session|@include common-session)' "$P"; then
    sed -i '0,/^\(session\|@include common-session\)/s//session optional pam_exec.so quiet \/usr\/lib\/carinaeos\/convidado pam\n&/' "$P"
  else
    printf 'session optional pam_exec.so quiet /usr/lib/carinaeos/convidado pam\n' >> "$P"
  fi
done
chmod 755 /usr/lib/carinaeos/convidado /usr/lib/carinaeos/agente-senha 2>/dev/null || true

# ---- agente de permissoes do CarinaeOS (janela de senha com a marca), no Plasma ---------
if [ -f /usr/lib/systemd/user/plasma-polkit-agent.service ]; then
  mkdir -p /usr/lib/systemd/user/plasma-polkit-agent.service.d
  cat > /usr/lib/systemd/user/plasma-polkit-agent.service.d/carinaeos.conf <<'EOT'
[Service]
Type=simple
ExecStart=
ExecStart=/usr/lib/carinaeos/agente-senha
EOT
fi

# ---- rede: pastas partilhadas do Windows/NAS e nomes .local ------------------------------
if [ -f /etc/samba/smb.conf ]; then
  grep -q 'client min protocol' /etc/samba/smb.conf || sed -i '/^\[global\]/a \   client min protocol = NT1\n   client max protocol = SMB3\n   name resolve order = bcast host lmhosts wins' /etc/samba/smb.conf
fi
systemctl enable avahi-daemon.service 2>/dev/null || true
# o servidor SMB do kernel (ksmbd) vem como dependencia mas nao esta configurado: nao arrancar
systemctl mask ksmbd.service 2>/dev/null || true

# ---- ecra de arranque (Plymouth) ------------------------------------------------
plymouth-set-default-theme carinaeos
update-initramfs -u -k all

# ---- menu de arranque do sistema instalado ----------------------------------------
# (o update-grub so corre depois da instalacao; aqui fica a configuracao pronta)
true
