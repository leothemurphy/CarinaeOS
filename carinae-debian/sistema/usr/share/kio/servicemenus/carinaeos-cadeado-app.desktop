[Desktop Entry]
Type=Service
MimeType=application/x-desktop;
Actions=trancarApp;destrancarApp;
X-KDE-Priority=TopLevel

[Desktop Action trancarApp]
Name=Trancar aplicativo com senha
Icon=object-locked
Exec=carinaeos-cadeado trancar-app %f

[Desktop Action destrancarApp]
Name=Destrancar aplicativo
Icon=object-unlocked
Exec=carinaeos-cadeado destrancar-app %f
