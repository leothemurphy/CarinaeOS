# CarinaeOS: Firefox em Flatpak (o profile-sync-daemon só conhece o Firefox instalado como pacote)
F="$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
if [[ -f "$F/profiles.ini" ]]; then
    index=0
    PSNAME="firefox"
    while read -r profileItem; do
        if [[ $(echo "$profileItem" | cut -c1) = "/" ]]; then
            DIRArr[$index]="$profileItem"
        else
            DIRArr[$index]="$F/$profileItem"
        fi
        (( index=index+1 ))
    done < <(grep '[Pp]'ath= "$F/profiles.ini" | sed 's/[Pp]ath=//')
fi

check_suffix=1
