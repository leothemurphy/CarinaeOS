[Unit]
Description=CarinaeOS - vigia da música (listas de pastas e Home Assistant)
PartOf=mpd.service
After=mpd.service
Wants=mpd.service

[Service]
ExecStart=/usr/lib/carinaeos/musica-vigia
Restart=always
RestartSec=5

# (sem [Install]: é o aplicativo Música que o liga, junto com o mpd, quando abre)
