#!/bin/sh
# CarinaeOS - sessao sem rastro: conta "convidado" sem senha, com a pasta pessoal so na memoria.
#   convidado ligar | desligar     (corre como root, pelo pkexec)
#   convidado pam                  (chamado pelo PAM ao entrar/sair; PAM_USER e PAM_TYPE)
set -e
U=convidado
H=/home/$U
case "$1" in
  ligar)
    if ! getent passwd $U >/dev/null; then
      useradd -M -d $H -s /bin/bash -c "Convidado (sem rastro)" $U
    fi
    passwd -d $U >/dev/null
    usermod -U -e '' $U 2>/dev/null || true
    rm -f /etc/carinaeos/convidado-desligado
    ;;
  desligar)
    getent passwd $U >/dev/null && usermod -L -e 1 $U
    mkdir -p /etc/carinaeos; touch /etc/carinaeos/convidado-desligado
    ;;
  pam)
    [ "$PAM_USER" = "$U" ] || exit 0
    case "$PAM_TYPE" in
      open_session)
        if ! mountpoint -q $H; then
          mkdir -p $H
          mount -t tmpfs -o size=25%,mode=0700,uid=$(id -u $U),gid=$(id -g $U) carinaeos-convidado $H
          cp -a /etc/skel/. $H/
          chown -R $U:$U $H
          # aviso no ambiente de trabalho
          mkdir -p "$H/Área de trabalho"
          printf '[Desktop Entry]\nType=Link\nName=LEIA-ME: sessão sem rastro\nIcon=preferences-system-privacy\nURL=file:///usr/share/carinaeos/convidado-leia-me.txt\n' > "$H/Área de trabalho/sem-rastro.desktop"
          chown -R $U:$U "$H/Área de trabalho"
        fi ;;
      close_session)
        # so apaga quando ja nao ha processos do convidado
        ( sleep 3
          pkill -KILL -u $U 2>/dev/null || true
          sleep 1
          mountpoint -q $H && umount -l $H
          rm -rf /var/tmp/*-$U /tmp/*$U* 2>/dev/null || true ) >/dev/null 2>&1 &
        ;;
    esac ;;
esac
exit 0
