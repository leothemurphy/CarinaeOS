#!/usr/bin/python3
"""CarinaeOS - vigia da música (corre sempre, mesmo com o aplicativo Música fechado).

  * Listas feitas «De uma pasta»: quando entra ou sai música nessa pasta, a lista acompanha.
  * Home Assistant: sempre que muda uma lista, uma rádio ou a biblioteca, pede ao Home Assistant
    que recarregue a integração MPD — as fontes novas aparecem logo, sem esperar.

Configuração (escrita pelo aplicativo Música): ~/.local/share/carinaeos/musica/preferencias.json
  ha_url, ha_token, listas_pasta {nome: pasta}, rede, senha
"""
import json
import os
import ssl
import sys
import time
import urllib.request

from mpd import MPDClient

PREFS = os.path.expanduser('~/.local/share/carinaeos/musica/preferencias.json')
PORTA = 6600


def prefs():
    try:
        with open(PREFS, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


def ligar():
    p = prefs()
    c = MPDClient()
    c.timeout = 30
    c.idletimeout = None
    c.connect('127.0.0.1', PORTA)
    if p.get('rede') and p.get('senha'):
        c.password(p['senha'])
    return c


def sincronizar_pastas(c):
    """As listas criadas a partir de uma pasta ficam iguais ao conteúdo da pasta."""
    mudou = False
    for nome, pasta in (prefs().get('listas_pasta') or {}).items():
        try:
            quer = sorted((x['file'] for x in c.listall(pasta) if 'file' in x), key=str.lower)
        except Exception:
            continue      # a pasta saiu da biblioteca: deixa a lista como está
        try:
            tem = [x for x in c.listplaylist(nome)]
        except Exception:
            tem = None
        if tem == quer:
            continue
        try:
            c.rm(nome)
        except Exception:
            pass
        for f in quer:
            c.playlistadd(nome, f)
        log('lista «%s» acompanhou a pasta: %d músicas' % (nome, len(quer)))
        mudou = True
    return mudou


def pedido(url, token, metodo='GET'):
    req = urllib.request.Request(url, method=metodo, data=b'' if metodo == 'POST' else None,
                                 headers={'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'})
    ctx = ssl.create_default_context()
    if url.startswith('https://') and prefs().get('ha_inseguro', True):
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE   # Home Assistant em casa costuma ter certificado próprio
    with urllib.request.urlopen(req, timeout=15, context=ctx) as r:
        t = r.read()
        return json.loads(t) if t else None


def avisar_ha():
    p = prefs()
    url, token = (p.get('ha_url') or '').rstrip('/'), p.get('ha_token') or ''
    if not url or not token:
        return
    try:
        entradas = pedido(url + '/api/config/config_entries/entry', token)
        for e in entradas or []:
            if e.get('domain') == 'mpd':
                pedido(url + '/api/config/config_entries/entry/%s/reload' % e['entry_id'], token, 'POST')
                log('Home Assistant: recarregada a integração MPD «%s»' % e.get('title', ''))
    except Exception as e:
        log('Home Assistant não respondeu:', e)


def principal():
    if '--agora' in sys.argv:          # o aplicativo Música pede um aviso imediato
        avisar_ha()
        return 0
    while True:
        try:
            c = ligar()
            ignorar_ate = 0
            if sincronizar_pastas(c):
                avisar_ha()
                ignorar_ate = time.time() + 4
            log('a vigiar o MPD')
            while True:
                mud = c.idle('stored_playlist', 'database')
                time.sleep(1.5)          # junta várias mudanças seguidas num só aviso
                avisar = False
                if 'database' in mud and sincronizar_pastas(c):
                    avisar, ignorar_ate = True, time.time() + 4   # a mudança que se segue é nossa
                elif 'stored_playlist' in mud and time.time() > ignorar_ate:
                    avisar = True        # lista ou rádio nova/mudada/apagada (pelo Música, mpc, Home Assistant…)
                if avisar:
                    avisar_ha()
        except Exception as e:
            log('conexão ao MPD perdida (%s); a tentar outra vez' % e)
            time.sleep(5)


if __name__ == '__main__':
    sys.exit(principal())
