#!/bin/sh
# CarinaeOS - instala (ou remove) um extra que não está no Debian nem no Flathub, de uma fonte fixa.
# Corre como root (pkexec). Só aceita os nomes desta lista; o endereço nunca vem de fora.
#   instalar-extra instalar artcraft | remover artcraft
set -e
case "$2" in
  artcraft)
    PACOTE=artcraft-launcher
    REPO=storytold/craft-launcher ;;
  *) echo "extra desconhecido: $2" >&2; exit 2 ;;
esac
case "$1" in
  instalar)
    T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
    V=$(curl -sfL "https://api.github.com/repos/$REPO/releases/latest" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')
    echo "$V" | grep -Eqx 'v?[0-9][0-9A-Za-z.+-]*' || { echo "versão inválida" >&2; exit 3; }
    N=${V#v}
    curl -sfL -o "$T/$PACOTE.deb" "https://github.com/$REPO/releases/download/$V/$PACOTE-$N-linux-x86_64.deb"
    dpkg-deb -f "$T/$PACOTE.deb" Package | grep -qx "$PACOTE" || { echo "o arquivo baixado não é o $PACOTE" >&2; exit 3; }
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -q "$T/$PACOTE.deb"
    ;;
  remover)
    apt-get remove -y -q "$PACOTE" ;;
  *) echo "uso: $0 instalar|remover NOME" >&2; exit 2 ;;
esac
