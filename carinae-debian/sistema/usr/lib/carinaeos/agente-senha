#!/usr/bin/python3
# CarinaeOS - agente de permissões (polkit): sempre que o sistema pede a senha para uma
# tarefa de administrador, aparece a janela do CarinaeOS (banner e logotipo) em vez da
# janela genérica. Se algo falhar ao arrancar, entrega o trabalho ao agente do KDE/GNOME.
#
# Fala com o polkitd pela D-Bus (interface org.freedesktop.PolicyKit1.AuthenticationAgent)
# e confirma a senha com o polkit-agent-helper-1 (o mesmo ajudante que os outros agentes usam).
import os
import pwd
import subprocess
import sys
import threading

AGENTES_RESERVA = ['/usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1',
                   '/usr/libexec/polkit-kde-authentication-agent-1',
                   '/usr/libexec/polkit-gnome-authentication-agent-1',
                   '/usr/libexec/xfce-polkit', '/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1']
AJUDANTES = ['/usr/lib/polkit-1/polkit-agent-helper-1', '/usr/libexec/polkit-agent-helper-1',
             '/usr/lib/policykit-1/polkit-agent-helper-1']
CAMINHO = '/org/carinaeos/AgenteSenha'
IFACE = 'org.freedesktop.PolicyKit1.AuthenticationAgent'


def reserva(motivo):
    sys.stderr.write('carinaeos-agente-senha: %s; a usar o agente de reserva\n' % motivo)
    sys.stderr.flush()
    for a in AGENTES_RESERVA:
        if os.path.exists(a):
            os.execv(a, [a])
    sys.exit(1)


try:
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    import gi
    gi.require_version('Polkit', '1.0')
    from gi.repository import Polkit
    sys.path.insert(0, '/usr/share/carinaeos/comum')
    from senha import Pedido, QML
    from PySide6.QtCore import QObject, QTimer, Signal
    from PySide6.QtGui import QGuiApplication, QIcon
    from PySide6.QtQml import QQmlApplicationEngine
    from PySide6.QtQuickControls2 import QQuickStyle
    AJUDANTE = next(a for a in AJUDANTES if os.path.exists(a))
except Exception as e:  # noqa: BLE001
    reserva('falta algo (%s)' % e)

NOMES = {
    'org.freedesktop.packagekit': 'instalar ou atualizar programas',
    'org.debian.apt': 'instalar ou atualizar programas',
    'org.freedesktop.policykit.exec': 'executar uma tarefa de administrador',
    'org.freedesktop.udisks2': 'usar um disco',
    'org.freedesktop.NetworkManager': 'mudar a rede',
    'org.freedesktop.timedate1': 'mudar a data e a hora',
    'org.freedesktop.login1': 'desligar ou reiniciar',
    'org.freedesktop.accounts': 'mudar os usuários',
    'org.kde.kcontrol': 'mudar uma configuração do sistema',
    'org.carinaeos': 'uma tarefa do CarinaeOS',
}


def resumo(action_id):
    for k, v in NOMES.items():
        if action_id.startswith(k):
            return v
    return 'uma tarefa de administrador'


def escolher_usuario(identidades):
    """Das identidades que o polkit aceita, o proprio usuario (se puder) ou o primeiro."""
    eu = os.getuid()
    usuarios, grupos = [], []
    for tipo, det in identidades:
        if tipo == 'unix-user':
            usuarios.append(int(det['uid']))
        elif tipo == 'unix-group':
            grupos.append(int(det['gid']))
    if eu in usuarios:
        return eu
    if grupos and any(g in os.getgroups() for g in grupos):
        return eu
    return usuarios[0] if usuarios else 0


class Ponte(QObject):
    linha = Signal(object, str)        # (pedido, linha do ajudante) -> na janela
    fim = Signal(object)


class Agente(dbus.service.Object):
    def __init__(self, bus, ponte):
        super().__init__(bus, CAMINHO)
        self.ponte = ponte
        self.fila = []
        self.atual = None
        ponte.linha.connect(self._linha)
        ponte.fim.connect(self._fim_ajudante)

    @dbus.service.method(IFACE, in_signature='sssa{ss}sa(sa{sv})', out_signature='',
                         async_callbacks=('ok', 'erro'))
    def BeginAuthentication(self, action_id, message, icon_name, details, cookie, identities, ok, erro):
        p = dict(acao=str(action_id), mensagem=str(message), detalhes={str(k): str(v) for k, v in details.items()},
                 cookie=str(cookie), ids=[(str(t), dict(d)) for t, d in identities], ok=ok, erro=erro)
        self.fila.append(p)
        QTimer.singleShot(0, self._seguinte)

    @dbus.service.method(IFACE, in_signature='s', out_signature='')
    def CancelAuthentication(self, cookie):
        for p in list(self.fila):
            if p['cookie'] == cookie:
                self.fila.remove(p)
                p['erro'](dbus.exceptions.DBusException('Cancelado', name='org.freedesktop.PolicyKit1.Error.Cancelled'))
        if self.atual and self.atual['cookie'] == cookie:
            self._terminar(self.atual, False, cancelado=True)

    # ---- a janela ---------------------------------------------------------------------------
    def _seguinte(self):
        if self.atual or not self.fila:
            return
        p = self.atual = self.fila.pop(0)
        uid = escolher_usuario(p['ids'])
        try:
            p['usuario'] = pwd.getpwuid(uid).pw_name
        except KeyError:
            p['usuario'] = 'root'
        quem = 'a senha do administrador (root)' if p['usuario'] == 'root' else 'a sua senha (%s)' % p['usuario']
        comando = p['detalhes'].get('command_line', '') or p['detalhes'].get('polkit.message', '')
        p['ui'] = Pedido('O sistema precisa da sua permissão',
                         '%s\n\nPara %s, digite %s.' % (p['mensagem'], resumo(p['acao']), quem),
                         subtitulo='Permissão de administrador', detalhe=comando[:300], botao='Autorizar')
        p['ui'].respondido.connect(lambda s, p=p: self._responder(p, s))
        p['ui'].cancelado.connect(lambda p=p: self._terminar(p, False, cancelado=True))
        p['motor'] = QQmlApplicationEngine()
        p['motor'].rootContext().setContextProperty('pedido', p['ui'])
        p['motor'].load(QML)
        self._ajudante(p)

    def _ajudante(self, p):
        """Arranca o polkit-agent-helper-1: ele pergunta a senha (PAM) e confirma ao polkitd."""
        p['pronto'] = False
        p['senha'] = None
        try:
            h = subprocess.Popen([AJUDANTE, p['usuario']], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, text=True, bufsize=1)
        except OSError as e:
            p['ui'].mostrar_erro('Não consegui pedir a senha (%s).' % e)
            return
        p['h'] = h
        h.stdin.write(p['cookie'] + '\n')
        h.stdin.flush()

        def ler(h=h):
            for l in h.stdout:
                self.ponte.linha.emit(p, l.rstrip('\n'))
            h.wait()
            self.ponte.fim.emit(p)
        threading.Thread(target=ler, daemon=True).start()

    def _linha(self, p, l):
        if p is not self.atual:
            return
        if l.startswith('PAM_PROMPT_ECHO_OFF') or l.startswith('PAM_PROMPT_ECHO_ON'):
            p['pronto'] = True
            if p['senha'] is not None:
                self._enviar(p, p['senha'])
        elif l.startswith('PAM_ERROR_MSG'):
            p['ui'].mostrar_erro(l.split(' ', 1)[-1])
        elif l == 'SUCCESS':
            p['resultado'] = True
        elif l == 'FAILURE':
            p['resultado'] = False

    def _enviar(self, p, senha):
        p['pronto'] = False
        p['senha'] = None
        try:
            p['h'].stdin.write(senha + '\n')
            p['h'].stdin.flush()
        except (OSError, ValueError):
            pass

    def _responder(self, p, senha):
        if p.get('pronto'):
            self._enviar(p, senha)
        else:
            p['senha'] = senha

    def _fim_ajudante(self, p):
        if p is not self.atual or p.get('acabou'):
            return
        if p.get('resultado'):
            self._terminar(p, True)
        else:
            p['ui'].mostrar_erro('Senha incorreta. Tente outra vez.')
            self._ajudante(p)                      # nova tentativa

    def _terminar(self, p, sucesso, cancelado=False):
        if p.get('acabou'):
            return
        p['acabou'] = True
        h = p.get('h')
        if h and h.poll() is None:
            try:
                h.kill()
            except OSError:
                pass
        for o in p['motor'].rootObjects():
            o.close()
            o.deleteLater()
        p['motor'].deleteLater()
        if sucesso:
            p['ok']()
        else:
            p['erro'](dbus.exceptions.DBusException('Cancelado pelo usuário',
                                                    name='org.freedesktop.PolicyKit1.Error.Cancelled'))
        self.atual = None
        QTimer.singleShot(0, self._seguinte)


def principal():
    QQuickStyle.setStyle('Basic')
    app = QGuiApplication(sys.argv[:1])
    app.setQuitOnLastWindowClosed(False)
    app.setDesktopFileName('carinaeos-central')
    app.setWindowIcon(QIcon.fromTheme('carinaeos'))
    try:
        DBusGMainLoop(set_as_default=True)
        sistema = dbus.SystemBus()
        try:   # o nome do agente do KDE, para o servico do Plasma saber que arrancou
            app._nome = dbus.service.BusName('org.kde.polkit-kde-authentication-agent-1', dbus.SessionBus())
        except Exception:
            pass
        ponte = Ponte()
        agente = Agente(sistema, ponte)
        sessao = Polkit.UnixSession.new_for_process_sync(os.getpid(), None)
        if sessao is None:
            raise RuntimeError('sem sessão')
        autoridade = dbus.Interface(sistema.get_object('org.freedesktop.PolicyKit1', '/org/freedesktop/PolicyKit1/Authority'),
                                    'org.freedesktop.PolicyKit1.Authority')
        sujeito = ('unix-session', {'session-id': dbus.String(sessao.get_session_id())})
        autoridade.RegisterAuthenticationAgent(sujeito, os.environ.get('LANG', 'pt_BR.UTF-8'), CAMINHO)
    except Exception as e:  # noqa: BLE001
        reserva('não consegui registar (%s)' % e)
    app.agente, app.ponte = agente, ponte
    sys.exit(app.exec())


if __name__ == '__main__':
    principal()
