#!/usr/bin/python3
"""CarinaeOS - deixa os apps do CarinaeOS prontos a abrir depressa.

Corre uma vez, um pouco depois de entrar na sessão, com prioridade mínima (só usa o
processador e o disco quando estão parados). Para cada app (Configurações, Central, Órbita…):
  - lê as bibliotecas Qt/PySide para a memória (a primeira abertura depois de ligar o PC
    era a lenta: o disco ainda não as tinha lido);
  - compila a interface (QML) para a cache do usuário, como a primeira abertura faria.
Não abre janelas (plataforma "offscreen") nem corre o código dos apps.

  aquecer-apps          todos os apps
  aquecer-apps um NOME  só um (uso interno: cada app num processo, porque a cache é por app)
"""
import os
import subprocess
import sys

BASE = '/usr/share/carinaeos'
# pasta -> nome do app (o mesmo que o app usa em iniciar(); a cache do QML fica em ~/.cache/<nome>)
APPS = {
    'configuracoes': 'carinaeos-configuracoes',
    'central': 'carinaeos-central',
    'orbita': 'carinaeos-orbita',
    'supernova': 'carinaeos-supernova',
    'musica': 'carinaeos-musica',
    'casa': 'carinaeos-casa',
    'atualizacoes': 'carinaeos-atualizacoes',
    'manual': 'carinaeos-manual',
}


def um(pasta):
    os.environ['QT_QPA_PLATFORM'] = 'offscreen'
    os.environ.setdefault('QT_LOGGING_RULES', '*.debug=false;*.warning=false')
    from PySide6.QtCore import QUrl
    from PySide6.QtGui import QGuiApplication
    from PySide6.QtQml import QQmlComponent, QQmlEngine
    from PySide6.QtQuickControls2 import QQuickStyle
    QQuickStyle.setStyle('Basic')
    app = QGuiApplication([APPS[pasta]])
    app.setApplicationName(APPS[pasta])
    motor = QQmlEngine()
    c = QQmlComponent(motor)
    # só compila (e grava a cache); não cria a janela
    c.loadUrl(QUrl.fromLocalFile(os.path.join(BASE, pasta, 'Main.qml')), QQmlComponent.CompilationMode.PreferSynchronous)
    ok = c.status() == QQmlComponent.Status.Ready
    del c, motor, app
    return 0 if ok else 1


def todos():
    if os.environ.get('XDG_SESSION_CLASS') == 'greeter':
        return 0
    for pasta in APPS:
        if not os.path.exists(os.path.join(BASE, pasta, 'Main.qml')):
            continue
        try:
            subprocess.run([sys.executable, os.path.abspath(__file__), 'um', pasta],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
        except Exception:
            pass
    return 0


if __name__ == '__main__':
    if sys.argv[1:2] == ['um'] and len(sys.argv) == 3 and sys.argv[2] in APPS:
        sys.exit(um(sys.argv[2]))
    sys.exit(todos())
