#!/bin/bash
# CarinaeOS - atualizar o sistema com um ponto de restauro antes (corre como root, pelo app Atualizações).
#   atualizar ponto "comentário"   cria um ponto de restauro (Timeshift, modo rsync, na partição do sistema)
#   atualizar sistema              ponto de restauro + apt full-upgrade + flatpak update
#   atualizar restaurar NOME       volta o sistema ao ponto NOME (os seus arquivos em /home não mudam) e reinicia
#   atualizar apagar NOME          apaga um ponto de restauro
# As linhas "@passo texto" e "@feito" são para o app mostrar o progresso.
set -o pipefail
export DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
MANTER=5                       # pontos de restauro do CarinaeOS guardados (os mais antigos saem)
PREFIXO="CarinaeOS:"

passo() { echo "@passo $*"; }

configurar() {
    # na primeira vez: modo rsync, guardado na própria partição do sistema
    if [ ! -s /etc/timeshift/timeshift.json ] || ! grep -q '"backup_device_uuid" *: *"[^"]' /etc/timeshift/timeshift.json; then
        local uuid
        uuid=$(findmnt -no UUID /)
        mkdir -p /etc/timeshift
        cat > /etc/timeshift/timeshift.json <<EOF
{
  "backup_device_uuid" : "$uuid",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "false",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "false",
  "schedule_daily" : "false",
  "schedule_hourly" : "false",
  "schedule_boot" : "false",
  "count_monthly" : "2",
  "count_weekly" : "3",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "5",
  "date_format" : "%d/%m/%Y %H:%M",
  "exclude" : [],
  "exclude-apps" : []
}
EOF
    fi
}

ponto() {
    command -v timeshift >/dev/null || { echo "@erro Falta o Timeshift (sudo apt install timeshift)."; return 1; }
    configurar
    passo "Criando o ponto de restauro…"
    timeshift --create --scripted --comments "$PREFIXO $1" 2>&1 | grep -vE '^\s*$' | tail -3
    local r=${PIPESTATUS[0]}
    [ "$r" -eq 0 ] || { echo "@erro Não foi possível criar o ponto de restauro."; return 1; }
    # guarda só os $MANTER mais recentes do CarinaeOS
    local lista
    mapfile -t lista < <(for d in /timeshift/snapshots/*/; do
        [ -f "$d/info.json" ] && grep -q "\"comments\" *: *\"$PREFIXO" "$d/info.json" && basename "$d"; done | sort)
    local n=$(( ${#lista[@]} - MANTER ))
    for ((i = 0; i < n; i++)); do
        timeshift --delete --snapshot "${lista[$i]}" --scripted >/dev/null 2>&1
    done
    return 0
}

case "$1" in
ponto)
    ponto "${2:-Ponto criado à mão}" && echo "@feito"
    ;;
sistema)
    ponto "Antes da atualização de $(date '+%d/%m/%Y %H:%M')" || exit 1
    passo "Procurando atualizações…"
    apt-get update -q 2>&1 | tail -2
    passo "Instalando as atualizações do sistema…"
    apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade 2>&1 \
        | grep -E '^(Setting up|Configurando|Unpacking|Desempacotando) ' | sed -E 's/^(Setting up|Configurando) /✓ /; s/^(Unpacking|Desempacotando) /… /'
    [ "${PIPESTATUS[0]}" -eq 0 ] || { echo "@erro A atualização do sistema falhou. Pode voltar ao ponto de restauro."; exit 1; }
    if command -v flatpak >/dev/null; then
        passo "Atualizando os aplicativos Flatpak…"
        flatpak update -y --system --noninteractive 2>&1 | tail -3
    fi
    apt-get -y -q autoclean >/dev/null 2>&1
    [ -f /var/run/reboot-required ] && echo "@reiniciar"
    echo "@feito"
    ;;
restaurar)
    [ -n "$2" ] || exit 2
    configurar
    passo "Voltando o sistema ao ponto de restauro… (não desligue o computador)"
    timeshift --restore --snapshot "$2" --scripted --yes --skip-grub 2>&1 | tail -5
    ;;
apagar)
    [ -n "$2" ] || exit 2
    timeshift --delete --snapshot "$2" --scripted 2>&1 | tail -2 && echo "@feito"
    ;;
*)
    echo "uso: atualizar ponto [comentário] | sistema | restaurar NOME | apagar NOME" >&2
    exit 2
    ;;
esac
