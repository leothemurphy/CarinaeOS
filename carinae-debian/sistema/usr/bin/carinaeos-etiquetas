#!/usr/bin/python3
# CarinaeOS - Etiquetas, como no Finder do Mac: cores e nomes para arquivos e pastas,
# tanto no computador como em pastas de rede (NAS, Windows, SFTP...).
#   carinaeos-etiquetas pôr ETIQUETA URL...      carinaeos-etiquetas tirar [ETIQUETA] URL...
#   carinaeos-etiquetas outra URL...              (pergunta o nome da etiqueta)
#   carinaeos-etiquetas listar
# - No computador grava em user.xdg.tags (o mesmo que o Dolphin/Baloo usa: aparece em "Etiquetas").
# - Na rede (onde não há atributos estendidos) guarda numa lista própria.
# - Em ~/Etiquetas/<etiqueta>/ ficam atalhos para tudo o que tem essa etiqueta (locais e de rede),
#   e essa pasta aparece na barra lateral dos Arquivos.
import json
import os
import shutil
import subprocess
import sys
import urllib.parse

HOME = os.path.expanduser('~')
DB = os.path.join(os.environ.get('XDG_DATA_HOME', os.path.join(HOME, '.local/share')), 'carinaeos', 'etiquetas.json')
PASTA = os.path.join(HOME, 'Etiquetas')
CORES = {'Vermelho': 'red', 'Laranja': 'orange', 'Amarelo': 'yellow', 'Verde': 'green',
         'Azul': 'blue', 'Roxo': 'violet', 'Cinzento': 'grey'}
ATTR = 'user.xdg.tags'


def ler():
    try:
        with open(DB, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def gravar(d):
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    tmp = DB + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(d, f, ensure_ascii=False, indent=1)
    os.replace(tmp, DB)


def local(url):
    if url.startswith('file://'):
        return urllib.parse.unquote(url[7:])
    if url.startswith('/'):
        return url
    return None


def xattr_ler(p):
    try:
        return [t for t in os.getxattr(p, ATTR).decode().split(',') if t]
    except OSError:
        return None


def xattr_gravar(p, tags):
    try:
        if tags:
            os.setxattr(p, ATTR, ','.join(tags).encode())
        else:
            try:
                os.removexattr(p, ATTR)
            except OSError:
                pass
        return True
    except OSError:
        return False


def cor_da_pasta(p, tags):
    """Pastas locais com etiqueta de cor ganham o ícone dessa cor (como no Mac)."""
    if not os.path.isdir(p):
        return
    cor = next((CORES[t] for t in tags if t in CORES), None)
    d = os.path.join(p, '.directory')
    linhas = []
    try:
        linhas = [l for l in open(d, encoding='utf-8').read().splitlines() if not l.startswith('Icon=folder-')]
    except OSError:
        pass
    if cor:
        if '[Desktop Entry]' not in linhas:
            linhas.insert(0, '[Desktop Entry]')
        linhas.insert(linhas.index('[Desktop Entry]') + 1, 'Icon=folder-%s' % cor)
    try:
        if any(l.strip() for l in linhas if l != '[Desktop Entry]'):
            open(d, 'w', encoding='utf-8').write('\n'.join(linhas) + '\n')
        elif os.path.exists(d):
            os.remove(d)
    except OSError:
        pass


def mudar(urls, por=None, tirar=None):
    db = ler()
    for u in urls:
        p = local(u)
        chave = u if not p else 'file://' + p
        atuais = set(db.get(chave, []))
        if p:
            x = xattr_ler(p)
            if x:
                atuais |= set(x)
        if por:
            atuais.add(por)
        if tirar == '*':
            atuais = set()
        elif tirar:
            atuais.discard(tirar)
        tags = sorted(atuais)
        if p:
            xattr_gravar(p, tags)
            cor_da_pasta(p, tags)
        if tags:
            db[chave] = tags
        else:
            db.pop(chave, None)
    gravar(db)
    atualizar_pasta(db)


XBEL_NOVO = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xbel>
<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:kdepriv="http://www.kde.org/kdepriv" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">
 <info>
  <metadata owner="http://www.kde.org">
   <kde_places_version>4</kde_places_version>
   <withRecentlyUsed>true</withRecentlyUsed>
   <withBaloo>true</withBaloo>
  </metadata>
 </info>
%s</xbel>
"""


def _marca(url, titulo, icone, ident, sistema=False):
    return (' <bookmark href="%s">\n  <title>%s</title>\n  <info>\n   <metadata owner="http://freedesktop.org">\n'
            '    <bookmark:icon name="%s"/>\n   </metadata>\n   <metadata owner="http://www.kde.org">\n'
            '    <ID>%s</ID>\n%s   </metadata>\n  </info>\n </bookmark>\n'
            % (url, titulo, icone, ident, '    <isSystemItem>true</isSystemItem>\n' if sistema else ''))


def _pasta_xdg(nome, padrao):
    try:
        r = subprocess.run(['xdg-user-dir', nome], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except OSError:
        pass
    return os.path.join(HOME, padrao)


def _xbel_padrao():
    itens = [('file://' + HOME, 'Início', 'user-home'),
             ('file://' + _pasta_xdg('DESKTOP', 'Área de trabalho'), 'Área de trabalho', 'user-desktop'),
             ('file://' + _pasta_xdg('DOCUMENTS', 'Documentos'), 'Documentos', 'folder-documents'),
             ('file://' + _pasta_xdg('DOWNLOAD', 'Downloads'), 'Downloads', 'folder-download'),
             ('file://' + _pasta_xdg('MUSIC', 'Músicas'), 'Música', 'folder-music'),
             ('file://' + _pasta_xdg('PICTURES', 'Imagens'), 'Imagens', 'folder-pictures'),
             ('file://' + _pasta_xdg('VIDEOS', 'Vídeos'), 'Vídeos', 'folder-videos'),
             ('trash:/', 'Lixeira', 'user-trash'),
             ('remote:/', 'Rede', 'folder-network')]
    t = int(__import__('time').time())
    return XBEL_NOVO % ''.join(_marca(u, n, i, '%d/%d' % (t, k), True) for k, (u, n, i) in enumerate(itens))


def lugar_nos_arquivos(tags):
    """Cada etiqueta (as 7 cores e as outras em uso) na barra lateral dos Arquivos, como no Finder."""
    xbel = os.path.join(HOME, '.local/share/user-places.xbel')
    try:
        txt = open(xbel, encoding='utf-8').read()
    except OSError:
        os.makedirs(os.path.dirname(xbel), exist_ok=True)
        txt = _xbel_padrao()
    if '</xbel>' not in txt:
        return
    # tira a entrada antiga (uma so pasta "Etiquetas")
    import re as _re
    txt = _re.sub(r' ?<bookmark href="file://%s">.*?</bookmark>\n' % _re.escape(PASTA), '', txt, flags=_re.S)
    novas = ''
    for k, t in enumerate(tags):
        url = 'file://' + urllib.parse.quote(os.path.join(PASTA, t))
        if 'href="%s"' % url in txt:
            continue
        icone = 'folder-%s' % CORES[t] if t in CORES else 'tag'
        novas += _marca(url, t, icone, 'carinaeos-etiqueta/%d' % k)
    if novas or not os.path.exists(xbel):
        open(xbel, 'w', encoding='utf-8').write(txt.replace('</xbel>', novas + '</xbel>', 1))
    # GNOME (Nautilus) e XFCE (Thunar): marcadores do GTK
    gtk = os.path.join(HOME, '.config/gtk-3.0/bookmarks')
    try:
        atual = open(gtk, encoding='utf-8').read()
    except OSError:
        atual = ''
    linhas = [l for l in atual.splitlines() if l.strip()]
    for t in tags:
        url = 'file://' + urllib.parse.quote(os.path.join(PASTA, t))
        if not any(l.split(' ')[0] == url for l in linhas):
            linhas.append('%s %s' % (url, t))
    os.makedirs(os.path.dirname(gtk), exist_ok=True)
    open(gtk, 'w', encoding='utf-8').write('\n'.join(linhas) + '\n')


def iniciar():
    """No inicio da sessao: as pastas das 7 cores e a barra lateral."""
    db = ler()
    atualizar_pasta(db)


def atualizar_pasta(db):
    """~/Etiquetas/<etiqueta>/ com atalhos para os itens (os de rede como links .desktop)."""
    por_tag = {}
    for url, tags in db.items():
        for t in tags:
            por_tag.setdefault(t, []).append(url)
    os.makedirs(PASTA, exist_ok=True)
    open(os.path.join(PASTA, '.directory'), 'w').write('[Desktop Entry]\nIcon=tag\n')
    for cor in CORES:                         # as cores existem sempre, como no Finder
        por_tag.setdefault(cor, [])
    lugar_nos_arquivos(list(CORES) + sorted(t for t in por_tag if t not in CORES))
    for t in os.listdir(PASTA):
        cam = os.path.join(PASTA, t)
        if os.path.isdir(cam) and t not in por_tag:
            for f in os.listdir(cam):
                os.remove(os.path.join(cam, f))
            os.rmdir(cam)
    for t, urls in por_tag.items():
        cam = os.path.join(PASTA, t)
        os.makedirs(cam, exist_ok=True)
        icone = 'folder-%s' % CORES[t] if t in CORES else 'tag'
        open(os.path.join(cam, '.directory'), 'w').write('[Desktop Entry]\nIcon=%s\n' % icone)
        for f in os.listdir(cam):
            if f != '.directory':
                os.remove(os.path.join(cam, f))
        for url in urls:
            nome = os.path.basename(urllib.parse.unquote(url.rstrip('/'))) or url
            p = local(url)
            if p:
                destino = os.path.join(cam, nome)
                if not os.path.lexists(destino):
                    os.symlink(p, destino)
            else:
                servidor = urllib.parse.urlparse(url).netloc
                with open(os.path.join(cam, nome + ' (rede).desktop'), 'w', encoding='utf-8') as f:
                    f.write('[Desktop Entry]\nType=Link\nName=%s\nComment=%s\nURL=%s\nIcon=folder-network\n'
                            % (nome, 'em ' + servidor, url))


def main():
    a = sys.argv[1:]
    if a and a[0] == 'iniciar':
        iniciar()
        return
    if not a or a[0] == 'listar':
        for url, tags in sorted(ler().items()):
            print('%s\t%s' % (', '.join(tags), url))
        return
    acao, resto = a[0], a[1:]
    if acao == 'pôr' and len(resto) >= 2:
        mudar(resto[1:], por=resto[0])
    elif acao == 'outra' and resto:
        cmd = (['kdialog', '--title', 'Etiqueta', '--inputbox', 'Nome da etiqueta:'] if shutil.which('kdialog') else
               ['zenity', '--entry', '--title', 'Etiqueta', '--text', 'Nome da etiqueta:'])
        r = subprocess.run(cmd, capture_output=True, text=True)
        nome = r.stdout.strip()
        if nome:
            mudar(resto, por=nome)
    elif acao == 'tirar' and resto:
        if len(resto) >= 2 and not ('://' in resto[0] or resto[0].startswith('/')):
            mudar(resto[1:], tirar=resto[0])
        else:
            mudar(resto, tirar='*')
    else:
        print(__doc__ if __doc__ else 'uso: carinaeos-etiquetas pôr|tirar|outra|listar ...')


if __name__ == '__main__':
    main()
