#!/usr/bin/python3
"""CarinaeOS - Deck: as ações das teclas do Deck (no Launchpad) e o estado de cada uma.

  carinaeos-deck catalogo          JSON: todas as ações que se podem pôr no Deck, por grupos
  carinaeos-deck estado <id>...    JSON: {id: {"ligado": true|false|null, "texto": "..."}}
  carinaeos-deck tocar <id>        faz a ação; escreve o estado novo (JSON)
  carinaeos-deck definir <id> ligar|desligar|tocar   como tocar, mas só se não estiver já assim (rotinas)

Ids:
  sis:dnd  sis:luz  sis:wifi  sis:bt  sis:energia:<perfil>  sis:som:<saída>
  sis:captura  sis:janelas  sis:mesa  sis:bloquear  sis:suspender
  mus:tocar  mus:pausar  mus:seguinte  mus:lista:<nome>
  rot:<id>                         uma rotina (app Rotinas): vários passos de seguida
  ha:<entity_id>                   (Home Assistant, pela ligação da app Casa)
"""
import datetime
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, '/usr/share/carinaeos/comum')
try:
    import casa_ha as HA
except Exception:       # sem a app Casa não há Home Assistant, o resto funciona
    HA = None
try:
    import rotinas as ROT
except Exception:
    ROT = None

ENERGIA = [('power-saver', 'Poupança', 'battery-profile-powersave'),
           ('balanced', 'Equilibrado', 'battery-profile-balanced'),
           ('performance', 'Desempenho', 'battery-profile-performance')]
HA_DOMINIOS = {'light': 'Luzes', 'switch': 'Interruptores', 'input_boolean': 'Interruptores', 'fan': 'Ventiladores',
               'scene': 'Cenas', 'script': 'Rotinas', 'cover': 'Persianas e portões', 'lock': 'Fechaduras',
               'media_player': 'Som e TV', 'button': 'Botões', 'input_button': 'Botões', 'automation': 'Automações',
               'climate': 'Clima', 'vacuum': 'Aspiradores'}
HA_ICONES = {'light': 'lightbulb', 'switch': 'system-switch-user', 'input_boolean': 'checkbox', 'fan': 'weather-windy',
             'scene': 'games-config-theme', 'script': 'media-playback-start', 'cover': 'view-split-top-bottom',
             'lock': 'object-locked', 'media_player': 'media-playback-start', 'button': 'input-mouse-click-left',
             'input_button': 'input-mouse-click-left', 'automation': 'run-build', 'climate': 'temperature-normal',
             'vacuum': 'edit-clear-all'}
SEM_ESTADO = ('scene', 'script', 'button', 'input_button', 'automation')


def sh(args, timeout=8):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def bg(args):
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def kread(f, g, k):
    return sh(['kreadconfig6', '--file', f, '--group', g, '--key', k]) or ''


def kwrite(f, g, k, v):
    sh(['kwriteconfig6', '--file', f, '--group', g, '--key', k, v])


# ---- saídas de som -------------------------------------------------------------------------
def saidas():
    try:
        d = json.loads(sh(['pactl', '-f', 'json', 'list', 'sinks']) or '[]')
    except ValueError:
        d = []
    return [(s['name'], s.get('description') or s['name']) for s in d if 'name' in s]


# ---- o estado de cada ação ------------------------------------------------------------------
def dnd_ligado():
    v = kread('plasmanotifyrc', 'DoNotDisturb', 'Until')
    try:
        p = [int(x) for x in v.split(',')]
        return datetime.datetime(*p[:6]) > datetime.datetime.now()
    except Exception:
        return False


def estado_sis(i):
    if i == 'sis:dnd':
        on = dnd_ligado()
        return {'ligado': on, 'texto': 'Ligado' if on else 'Desligado'}
    if i == 'sis:luz':
        on = kread('kwinrc', 'NightColor', 'Active') == 'true'
        return {'ligado': on, 'texto': 'Ligada' if on else 'Desligada'}
    if i == 'sis:wifi':
        on = sh(['nmcli', 'radio', 'wifi']) == 'enabled'
        return {'ligado': on, 'texto': 'Ligado' if on else 'Desligado'}
    if i == 'sis:bt':
        on = 'Powered: yes' in (sh(['bluetoothctl', 'show'], 4) or '')
        return {'ligado': on, 'texto': 'Ligado' if on else 'Desligado'}
    if i.startswith('sis:energia:'):
        on = sh(['powerprofilesctl', 'get']) == i.split(':', 2)[2]
        return {'ligado': on, 'texto': 'Em uso' if on else ''}
    if i.startswith('sis:som:'):
        on = sh(['pactl', 'get-default-sink']) == i.split(':', 2)[2]
        return {'ligado': on, 'texto': 'Em uso' if on else ''}
    return {'ligado': None, 'texto': ''}


def estado_mus(i):
    st = sh(['mpc', 'status'], 4) or ''
    toca = '[playing]' in st
    if i == 'mus:tocar':
        titulo = st.splitlines()[0] if toca and st else ''
        return {'ligado': toca, 'texto': titulo or ('Tocando' if toca else 'Parada')}
    return {'ligado': None, 'texto': ''}


def estados(ids):
    r = {}
    ha = [i[3:] for i in ids if i.startswith('ha:')]
    if ha and HA and HA.ligado():
        try:
            todos = {s['entity_id']: s for s in (HA.pedido(HA.ler(), '/api/states', timeout=6) or [])}
        except Exception:
            todos = None
        for e in ha:
            s = (todos or {}).get(e)
            dom = e.split('.')[0]
            if todos is None:
                r['ha:' + e] = {'ligado': None, 'texto': 'Sem conexão'}
            elif not s:
                r['ha:' + e] = {'ligado': None, 'texto': 'Não encontrado'}
            elif dom in SEM_ESTADO:
                r['ha:' + e] = {'ligado': None, 'texto': ''}
            else:
                st = s.get('state', '')
                at = s.get('attributes') or {}
                on = st in ('on', 'open', 'opening', 'unlocked', 'playing', 'cleaning', 'heat', 'cool', 'auto', 'heat_cool')
                txt = {'on': 'Ligado', 'off': 'Desligado', 'open': 'Aberto', 'closed': 'Fechado', 'locked': 'Trancada',
                       'unlocked': 'Destrancada', 'playing': 'Tocando', 'paused': 'Em pausa', 'idle': 'Parado',
                       'unavailable': 'Indisponível'}.get(st, st)
                if dom == 'light' and st == 'on' and at.get('brightness'):
                    txt = 'Ligada · %d%%' % round(at['brightness'] * 100 / 255)
                elif dom == 'light':
                    txt = {'Ligado': 'Ligada', 'Desligado': 'Desligada'}.get(txt, txt)
                r['ha:' + e] = {'ligado': on, 'texto': txt}
    elif ha:
        for e in ha:
            r['ha:' + e] = {'ligado': None, 'texto': 'Ligue o Carinae Casa'}
    for i in ids:
        if i.startswith('sis:'):
            r[i] = estado_sis(i)
        elif i.startswith('mus:'):
            r[i] = estado_mus(i)
        elif i.startswith('rot:'):
            r[i] = {'ligado': None, 'texto': 'Rodando…' if ROT and ROT.correndo(i[4:]) else ''}
    return r


# ---- fazer -----------------------------------------------------------------------------------
def kwin_atalho(nome):
    sh(['qdbus6', 'org.kde.kglobalaccel', '/component/kwin', 'org.kde.kglobalaccel.Component.invokeShortcut', nome])


def tocar(i):
    if i == 'sis:dnd':
        if dnd_ligado():
            kwrite('plasmanotifyrc', 'DoNotDisturb', 'Until', '')
        else:
            kwrite('plasmanotifyrc', 'DoNotDisturb', 'Until', '2099,12,31,23,59,0')
    elif i == 'sis:luz':
        if kread('kwinrc', 'NightColor', 'Active') == 'true':
            kwrite('kwinrc', 'NightColor', 'Active', 'false')
        else:
            kwrite('kwinrc', 'NightColor', 'Active', 'true')
            kwrite('kwinrc', 'NightColor', 'Mode', 'Constant')
        sh(['qdbus6', 'org.kde.KWin', '/KWin', 'reconfigure'])
    elif i == 'sis:wifi':
        sh(['nmcli', 'radio', 'wifi', 'off' if sh(['nmcli', 'radio', 'wifi']) == 'enabled' else 'on'])
    elif i == 'sis:bt':
        on = 'Powered: yes' in (sh(['bluetoothctl', 'show'], 4) or '')
        sh(['bluetoothctl', 'power', 'off' if on else 'on'], 6)
    elif i.startswith('sis:energia:'):
        sh(['powerprofilesctl', 'set', i.split(':', 2)[2]])
    elif i.startswith('sis:som:'):
        nome = i.split(':', 2)[2]
        sh(['pactl', 'set-default-sink', nome])
        # o que já está a tocar passa também para a saída nova
        for linha in (sh(['pactl', 'list', 'short', 'sink-inputs']) or '').splitlines():
            sh(['pactl', 'move-sink-input', linha.split()[0], nome])
    elif i == 'sis:captura':
        bg(['spectacle'])
    elif i == 'sis:janelas':
        kwin_atalho('Overview')
    elif i == 'sis:mesa':
        kwin_atalho('Show Desktop')
    elif i == 'sis:bloquear':
        bg(['loginctl', 'lock-session'])
    elif i == 'sis:suspender':
        bg(['systemctl', 'suspend'])
    elif i == 'mus:tocar':
        sh(['mpc', 'toggle'])
    elif i == 'mus:pausar':
        sh(['mpc', 'pause'])
    elif i == 'mus:seguinte':
        sh(['mpc', 'next'])
    elif i.startswith('mus:lista:'):
        nome = i.split(':', 2)[2]
        sh(['mpc', 'clear'])
        sh(['mpc', 'load', nome])
        sh(['mpc', 'play'])
    elif i.startswith('ha:') and HA:
        HA.alternar(i[3:])
    elif i.startswith('rot:') and ROT:
        ROT.lancar(i[4:])
        return {'ligado': None, 'texto': 'Rodando…'}
    return estados([i]).get(i, {'ligado': None, 'texto': ''})


def definir(i, modo):
    """Para as rotinas: ligar/desligar só mexe se ainda não estiver assim; tocar faz sempre."""
    if modo in ('ligar', 'desligar'):
        e = estados([i]).get(i, {})
        if e.get('ligado') is not None and e['ligado'] == (modo == 'ligar'):
            return e
    return tocar(i)


# ---- catálogo --------------------------------------------------------------------------------
def catalogo():
    g = []
    sis = [
        dict(id='sis:dnd', nome='Não incomodar', icone='notifications-disabled'),
        dict(id='sis:luz', nome='Luz noturna', icone='redshift-status-on'),
        dict(id='sis:wifi', nome='Wi-Fi', icone='network-wireless'),
        dict(id='sis:bt', nome='Bluetooth', icone='preferences-system-bluetooth'),
        dict(id='sis:captura', nome='Captura de tela', icone='spectacle'),
        dict(id='sis:janelas', nome='Todas as janelas', icone='view-grid'),
        dict(id='sis:mesa', nome='Mostrar a área de trabalho', icone='user-desktop'),
        dict(id='sis:bloquear', nome='Bloquear', icone='system-lock-screen'),
        dict(id='sis:suspender', nome='Suspender', icone='system-suspend'),
    ]
    if sh(['powerprofilesctl', 'list']) is not None:
        sis += [dict(id='sis:energia:' + p, nome='Energia: ' + n, icone=ic) for p, n, ic in ENERGIA]
    g.append(dict(grupo='Sistema', itens=sis))
    som = [dict(id='sis:som:' + n, nome=d, icone='audio-card') for n, d in saidas()]
    if som:
        g.append(dict(grupo='Saída de som', itens=som))
    if ROT:
        rots = [dict(id='rot:' + r['id'], nome=r['nome'], icone=r.get('icone') or 'media-playlist-play') for r in ROT.ler()]
        g.insert(0, dict(grupo='Rotinas', itens=rots + [dict(id='rot:+nova', nome='Criar rotina…', icone='list-add')],
                         aviso='Um toque faz várias coisas de seguida: abrir apps, Não incomodar, som, música, luzes da casa…'))
    mus = [dict(id='mus:tocar', nome='Tocar / pausar', icone='media-playback-start'),
           dict(id='mus:pausar', nome='Pausar a música', icone='media-playback-pause'),
           dict(id='mus:seguinte', nome='Música seguinte', icone='media-skip-forward')]
    for n in (sh(['mpc', 'lsplaylists'], 4) or '').splitlines():
        if n.strip():
            mus.append(dict(id='mus:lista:' + n, nome=n, icone='radio' if re.search(r'r[aá]dio|fm\b', n, re.I) else 'view-media-playlist'))
    g.append(dict(grupo='Música', itens=mus))
    if HA and HA.ligado():
        try:
            casa = {}
            for e in HA.entidades():
                dom = e['dominio']
                if dom in HA_DOMINIOS:
                    casa.setdefault(HA_DOMINIOS[dom], []).append(
                        dict(id='ha:' + e['id'], nome=e['nome'], icone=HA_ICONES.get(dom, 'go-home')))
            for nome, itens in casa.items():
                g.append(dict(grupo='Casa · ' + nome, itens=itens))
        except Exception as ex:
            g.append(dict(grupo='Casa', itens=[], aviso='Não consegui falar com o Home Assistant (%s).' % ex))
    else:
        g.append(dict(grupo='Casa', itens=[], aviso='Ligue o Home Assistant no Carinae Casa para colocar luzes e cenas aqui.'))
    return g


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__)
        return 1
    if a[0] == 'catalogo':
        print(json.dumps(catalogo()))
    elif a[0] == 'estado':
        print(json.dumps(estados(a[1:])))
    elif a[0] == 'tocar' and len(a) > 1:
        print(json.dumps(tocar(a[1])))
    elif a[0] == 'definir' and len(a) > 2:
        print(json.dumps(definir(a[1], a[2])))
    else:
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
