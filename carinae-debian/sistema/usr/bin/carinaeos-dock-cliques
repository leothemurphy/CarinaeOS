#!/usr/bin/python3
"""CarinaeOS - onde a Dock aceita cliques (X11).

A Dock fica sempre com a altura da lupa (não muda de tamanho, por isso não engasga);
a parte transparente por cima do vidro deixa passar os cliques para as janelas de trás.
Isto é a "forma de entrada" (X Shape, ShapeInput) da janela da Dock.

  carinaeos-dock-cliques --teste             escreve "ok" se der para usar (sessão X11)
  carinaeos-dock-cliques X Y L A cx cy       só o retângulo X,Y,L,A (na tela) aceita cliques
  carinaeos-dock-cliques tudo cx cy          a janela inteira aceita cliques
cx,cy: um ponto da tela dentro da Dock (para encontrar a janela dela).
"""
import ctypes
import ctypes.util
import os
import sys

c_ulong, c_long, c_int, c_uint = ctypes.c_ulong, ctypes.c_long, ctypes.c_int, ctypes.c_uint


class XRectangle(ctypes.Structure):
    _fields_ = [('x', ctypes.c_short), ('y', ctypes.c_short), ('width', ctypes.c_ushort), ('height', ctypes.c_ushort)]


class XWindowAttributes(ctypes.Structure):
    _fields_ = [('x', c_int), ('y', c_int), ('width', c_int), ('height', c_int), ('border_width', c_int),
                ('depth', c_int), ('visual', ctypes.c_void_p), ('root', c_ulong), ('class_', c_int),
                ('bit_gravity', c_int), ('win_gravity', c_int), ('backing_store', c_int),
                ('backing_planes', c_ulong), ('backing_pixel', c_ulong), ('save_under', c_int),
                ('colormap', c_ulong), ('map_installed', c_int), ('map_state', c_int),
                ('all_event_masks', c_long), ('your_event_mask', c_long), ('do_not_propagate_mask', c_long),
                ('override_redirect', c_int), ('screen', ctypes.c_void_p)]


def abrir():
    if os.environ.get('XDG_SESSION_TYPE', 'x11') == 'wayland' or not os.environ.get('DISPLAY'):
        return None
    x11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library('X11') or 'libX11.so.6')
    ext = ctypes.cdll.LoadLibrary(ctypes.util.find_library('Xext') or 'libXext.so.6')
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    d = x11.XOpenDisplay(None)
    if not d:
        return None
    for f in ('XDefaultRootWindow',):
        getattr(x11, f).restype = c_ulong
        getattr(x11, f).argtypes = [ctypes.c_void_p]
    x11.XInternAtom.restype = c_ulong
    x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, c_int]
    x11.XGetWindowProperty.argtypes = [ctypes.c_void_p, c_ulong, c_ulong, c_long, c_long, c_int, c_ulong,
                                       ctypes.POINTER(c_ulong), ctypes.POINTER(c_int), ctypes.POINTER(c_ulong),
                                       ctypes.POINTER(c_ulong), ctypes.POINTER(ctypes.c_void_p)]
    x11.XGetWindowAttributes.argtypes = [ctypes.c_void_p, c_ulong, ctypes.POINTER(XWindowAttributes)]
    x11.XTranslateCoordinates.argtypes = [ctypes.c_void_p, c_ulong, c_ulong, c_int, c_int,
                                          ctypes.POINTER(c_int), ctypes.POINTER(c_int), ctypes.POINTER(c_ulong)]
    x11.XFree.argtypes = [ctypes.c_void_p]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XSync.argtypes = [ctypes.c_void_p, c_int]
    ext.XShapeQueryExtension.argtypes = [ctypes.c_void_p, ctypes.POINTER(c_int), ctypes.POINTER(c_int)]
    ext.XShapeCombineRectangles.argtypes = [ctypes.c_void_p, c_ulong, c_int, c_int, c_int,
                                            ctypes.POINTER(XRectangle), c_int, c_int, c_int]
    ext.XShapeCombineMask.argtypes = [ctypes.c_void_p, c_ulong, c_int, c_int, c_int, c_ulong, c_int]
    a, b = c_int(), c_int()
    if not ext.XShapeQueryExtension(d, ctypes.byref(a), ctypes.byref(b)):
        return None
    return x11, ext, d


def propriedade(x11, d, w, nome):
    """Lista de valores (32 bits) de uma propriedade da janela."""
    tipo, fmt, n, resto, dados = c_ulong(), c_int(), c_ulong(), c_ulong(), ctypes.c_void_p()
    atom = x11.XInternAtom(d, nome.encode(), 0)
    if x11.XGetWindowProperty(d, w, atom, 0, 4096, 0, 0, ctypes.byref(tipo), ctypes.byref(fmt), ctypes.byref(n),
                              ctypes.byref(resto), ctypes.byref(dados)) != 0 or not dados.value:
        return []
    r = [ctypes.cast(dados, ctypes.POINTER(c_ulong))[i] for i in range(n.value)] if fmt.value == 32 else []
    x11.XFree(dados)
    return r


def janela_da_dock(x11, d, cx, cy):
    """A janela do tipo "dock" que contém o ponto; a mais alta (a da Dock, não o espaçador)."""
    raiz = x11.XDefaultRootWindow(d)
    tipo_dock = x11.XInternAtom(d, b'_NET_WM_WINDOW_TYPE_DOCK', 0)
    melhor, alt = None, -1
    for w in propriedade(x11, d, raiz, '_NET_CLIENT_LIST'):
        if tipo_dock not in propriedade(x11, d, w, '_NET_WM_WINDOW_TYPE'):
            continue
        at = XWindowAttributes()
        if not x11.XGetWindowAttributes(d, w, ctypes.byref(at)):
            continue
        gx, gy, filho = c_int(), c_int(), c_ulong()
        x11.XTranslateCoordinates(d, w, raiz, 0, 0, ctypes.byref(gx), ctypes.byref(gy), ctypes.byref(filho))
        if gx.value <= cx < gx.value + at.width and gy.value <= cy < gy.value + at.height and at.height > alt:
            melhor, alt = (w, gx.value, gy.value, at.width, at.height), at.height
    return melhor


def main():
    a = sys.argv[1:]
    x = abrir()
    if a[:1] == ['--teste']:
        print('ok' if x else 'nao')
        return 0
    if not x:
        return 1
    x11, ext, d = x
    SHAPE_INPUT, SHAPE_SET = 2, 0
    if a[:1] == ['tudo'] and len(a) == 3:
        j = janela_da_dock(x11, d, int(float(a[1])), int(float(a[2])))
        if not j:
            return 1
        ext.XShapeCombineMask(d, j[0], SHAPE_INPUT, 0, 0, 0, SHAPE_SET)
    elif len(a) == 6:
        rx, ry, rl, ra, cx, cy = (int(round(float(v))) for v in a)
        j = janela_da_dock(x11, d, cx, cy)
        if not j:
            return 1
        w, gx, gy, wl, wa = j
        # o retângulo, em coordenadas da janela e dentro dela
        x0, y0 = max(0, rx - gx), max(0, ry - gy)
        x1, y1 = min(wl, rx - gx + rl), min(wa, ry - gy + ra)
        if x1 <= x0 or y1 <= y0:
            return 1
        r = XRectangle(x0, y0, x1 - x0, y1 - y0)
        ext.XShapeCombineRectangles(d, w, SHAPE_INPUT, 0, 0, ctypes.byref(r), 1, SHAPE_SET, 0)
    else:
        print(__doc__)
        return 2
    x11.XSync(d, 0)
    return 0


if __name__ == '__main__':
    sys.exit(main())
