#!/usr/bin/python3
"""CarinaeOS - os favoritos do navegador principal, para o Deck (Launchpad).

  carinaeos-favoritos        JSON: {"navegador": "...", "itens": [{tipo: site|pasta, nome, url, icone, itens}]}

Lê a barra de favoritos do navegador padrão (Chrome, Brave, Chromium, Edge, Vivaldi — instalados ou
Flatpak — e Firefox). Os ícones dos sites vêm do cache do próprio navegador (sem ir à internet) e
ficam em ~/.cache/carinaeos/favicons. Só lê: nunca mexe nos favoritos.
"""
import glob
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile

HOME = os.path.expanduser('~')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.join(HOME, '.cache')), 'carinaeos', 'favicons')
MAX = 80

# (nome, palavras do .desktop, pastas do perfil possíveis)
CHROMIUMS = [
    ('Google Chrome', ('chrome',), ['.var/app/com.google.Chrome/config/google-chrome', '.config/google-chrome']),
    ('Brave', ('brave',), ['.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser', '.config/BraveSoftware/Brave-Browser']),
    ('Microsoft Edge', ('edge',), ['.var/app/com.microsoft.Edge/config/microsoft-edge', '.config/microsoft-edge']),
    ('Vivaldi', ('vivaldi',), ['.var/app/com.vivaldi.Vivaldi/config/vivaldi', '.config/vivaldi']),
    ('Chromium', ('chromium',), ['.var/app/org.chromium.Chromium/config/chromium', '.config/chromium']),
]
FIREFOX = ['.var/app/org.mozilla.firefox/.mozilla/firefox', '.mozilla/firefox']


def navegador_padrao():
    try:
        return subprocess.run(['xdg-settings', 'get', 'default-web-browser'], capture_output=True, text=True,
                              timeout=5).stdout.strip().lower()
    except Exception:
        return ''


def _perfil_chromium(base):
    """O perfil em uso: o "last_used" do Local State, senão Default."""
    try:
        with open(os.path.join(base, 'Local State'), encoding='utf-8') as f:
            p = json.load(f).get('profile', {}).get('last_used')
        if p and os.path.isfile(os.path.join(base, p, 'Bookmarks')):
            return os.path.join(base, p)
    except (OSError, ValueError):
        pass
    return os.path.join(base, 'Default')


def _copia(caminho):
    """Os bancos do navegador estão trancados enquanto ele está aberto: lê-se uma cópia."""
    d = tempfile.mkdtemp(prefix='carinaeos-fav-')
    destino = os.path.join(d, os.path.basename(caminho))
    shutil.copy2(caminho, destino)
    for ext in ('-wal', '-shm'):
        if os.path.exists(caminho + ext):
            shutil.copy2(caminho + ext, destino + ext)
    return d, destino


def _guardar_icone(url, dados):
    if not dados:
        return ''
    os.makedirs(CACHE, exist_ok=True)
    arq = os.path.join(CACHE, hashlib.md5(url.encode()).hexdigest() + '.png')
    try:
        with open(arq, 'wb') as f:
            f.write(dados)
        return arq
    except OSError:
        return ''


def _icones_chromium(perfil, urls):
    r = {}
    db = os.path.join(perfil, 'Favicons')
    if not urls or not os.path.isfile(db):
        return r
    d = None
    try:
        d, c = _copia(db)
        con = sqlite3.connect('file:%s?mode=ro' % c, uri=True)
        for u in urls:
            linha = con.execute(
                'SELECT b.image_data FROM icon_mapping m JOIN favicon_bitmaps b ON b.icon_id = m.icon_id '
                'WHERE m.page_url = ? ORDER BY (b.width >= 32) DESC, abs(b.width - 64) LIMIT 1', (u,)).fetchone()
            if not linha:      # a página guardada não tem ícone próprio: o do mesmo site
                base = u.split('/', 3)[:3]
                linha = con.execute(
                    'SELECT b.image_data FROM icon_mapping m JOIN favicon_bitmaps b ON b.icon_id = m.icon_id '
                    'WHERE m.page_url LIKE ? ORDER BY (b.width >= 32) DESC, abs(b.width - 64) LIMIT 1',
                    ('/'.join(base) + '/%',)).fetchone()
            if linha:
                r[u] = _guardar_icone(u, linha[0])
        con.close()
    except Exception:
        pass
    finally:
        if d:
            shutil.rmtree(d, ignore_errors=True)
    return r


def chromium(nome, base):
    perfil = _perfil_chromium(base)
    try:
        with open(os.path.join(perfil, 'Bookmarks'), encoding='utf-8') as f:
            raiz = json.load(f)['roots']
    except (OSError, ValueError, KeyError):
        return None
    urls = []

    def conv(n, nivel=0):
        if n.get('type') == 'url':
            urls.append(n.get('url', ''))
            return dict(tipo='site', nome=n.get('name') or n.get('url', ''), url=n.get('url', ''), icone='')
        if n.get('type') == 'folder' and nivel < 4:
            return dict(tipo='pasta', nome=n.get('name') or 'Pasta', itens=[x for x in (conv(c, nivel + 1) for c in n.get('children', [])[:MAX]) if x])
        return None
    barra = raiz.get('bookmark_bar', {}).get('children', [])
    itens = [x for x in (conv(c) for c in barra[:MAX]) if x]
    outros = raiz.get('other', {}).get('children', [])
    if outros:
        itens.append(dict(tipo='pasta', nome='Outros favoritos', itens=[x for x in (conv(c, 1) for c in outros[:MAX]) if x]))
    ic = _icones_chromium(perfil, urls)

    def por_icone(l):
        for x in l:
            if x['tipo'] == 'site':
                x['icone'] = ic.get(x['url'], '')
            else:
                por_icone(x['itens'])
    por_icone(itens)
    return dict(navegador=nome, itens=itens)


def firefox():
    for base in FIREFOX:
        perfis = sorted(glob.glob(os.path.join(HOME, base, '*', 'places.sqlite')), key=os.path.getmtime, reverse=True)
        if not perfis:
            continue
        perfil = os.path.dirname(perfis[0])
        d = None
        try:
            d, c = _copia(os.path.join(perfil, 'places.sqlite'))
            con = sqlite3.connect('file:%s?mode=ro' % c, uri=True)
            barra = con.execute("SELECT id FROM moz_bookmarks WHERE guid = 'toolbar_____'").fetchone()
            urls = []

            def filhos(pai, nivel=0):
                r = []
                for ident, tipo, titulo, url in con.execute(
                        'SELECT b.id, b.type, b.title, p.url FROM moz_bookmarks b LEFT JOIN moz_places p ON p.id = b.fk '
                        'WHERE b.parent = ? ORDER BY b.position LIMIT ?', (pai, MAX)):
                    if tipo == 1 and url and not url.startswith('place:'):
                        urls.append(url)
                        r.append(dict(tipo='site', nome=titulo or url, url=url, icone=''))
                    elif tipo == 2 and nivel < 4:
                        r.append(dict(tipo='pasta', nome=titulo or 'Pasta', itens=filhos(ident, nivel + 1)))
                return r
            itens = filhos(barra[0]) if barra else []
            con.close()
            # ícones: favicons.sqlite
            fdb = os.path.join(perfil, 'favicons.sqlite')
            if os.path.isfile(fdb) and urls:
                d2, c2 = _copia(fdb)
                try:
                    con = sqlite3.connect('file:%s?mode=ro' % c2, uri=True)
                    ic = {}
                    for u in urls:
                        linha = con.execute(
                            'SELECT i.data FROM moz_pages_w_icons p JOIN moz_icons_to_pages t ON t.page_id = p.id '
                            'JOIN moz_icons i ON i.id = t.icon_id WHERE p.page_url = ? ORDER BY abs(i.width - 64) LIMIT 1', (u,)).fetchone()
                        if linha:
                            ic[u] = _guardar_icone(u, linha[0])
                    con.close()

                    def por_icone(l):
                        for x in l:
                            if x['tipo'] == 'site':
                                x['icone'] = ic.get(x['url'], '')
                            else:
                                por_icone(x['itens'])
                    por_icone(itens)
                finally:
                    shutil.rmtree(d2, ignore_errors=True)
            return dict(navegador='Firefox', itens=itens)
        except Exception:
            continue
        finally:
            if d:
                shutil.rmtree(d, ignore_errors=True)
    return None


def favoritos():
    padrao = navegador_padrao()
    ordem = sorted(CHROMIUMS, key=lambda c: not any(p in padrao for p in c[1]))
    if 'firefox' in padrao:
        r = firefox()
        if r:
            return r
    for nome, _, pastas in ordem:
        for p in pastas:
            base = os.path.join(HOME, p)
            if os.path.isdir(base):
                r = chromium(nome, base)
                if r:
                    return r
    return firefox() or dict(navegador='', itens=[])


if __name__ == '__main__':
    print(json.dumps(favoritos(), ensure_ascii=False))
    sys.exit(0)
