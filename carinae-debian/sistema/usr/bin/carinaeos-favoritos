#!/usr/bin/python3
"""CarinaeOS - os favoritos do navegador principal, para o Deck (Launchpad).

  carinaeos-favoritos        JSON: {"navegador", "titulo", "itens": [{tipo: site|pasta, nome, url, icone, itens, meu}], "ocultos": n}
  carinaeos-favoritos adicionar NOME URL      um site só do Deck (os favoritos do navegador não mudam)
  carinaeos-favoritos editar URL NOME NOVA_URL
  carinaeos-favoritos remover URL             tira um site do Deck (os do navegador ficam só ocultos)
  carinaeos-favoritos mostrar-todos           volta a mostrar os que foram ocultos

Lê a barra de favoritos do navegador padrão (Chrome, Brave, Chromium, Edge, Vivaldi — instalados ou
Flatpak — e Firefox); sem favoritos, os sites mais visitados (do histórico do navegador). Os ícones dos sites vêm do cache do próprio navegador (sem ir à internet) e
ficam em ~/.cache/carinaeos/favicons. Só lê: nunca mexe nos favoritos.
"""
import glob
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile

HOME = os.path.expanduser('~')
DECK = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.join(HOME, '.config')), 'carinaeos', 'deck-sites.json')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME', os.path.join(HOME, '.cache')), 'carinaeos', 'favicons')
MAX = 80

# (nome, palavras do .desktop, pastas do perfil possíveis)
CHROMIUMS = [
    ('Google Chrome', ('chrome',), ['.var/app/com.google.Chrome/config/google-chrome', '.config/google-chrome']),
    ('Brave', ('brave',), ['.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser', '.config/BraveSoftware/Brave-Browser']),
    ('Microsoft Edge', ('edge',), ['.var/app/com.microsoft.Edge/config/microsoft-edge', '.config/microsoft-edge']),
    ('Vivaldi', ('vivaldi',), ['.var/app/com.vivaldi.Vivaldi/config/vivaldi', '.config/vivaldi']),
    ('Chromium', ('chromium',), ['.var/app/org.chromium.Chromium/config/chromium', '.config/chromium']),
]
FIREFOX = ['.var/app/org.mozilla.firefox/.mozilla/firefox', '.mozilla/firefox']


def navegador_padrao():
    try:
        return subprocess.run(['xdg-settings', 'get', 'default-web-browser'], capture_output=True, text=True,
                              timeout=5).stdout.strip().lower()
    except Exception:
        return ''


def _perfil_chromium(base):
    """O perfil em uso: o "last_used" do Local State, senão Default."""
    try:
        with open(os.path.join(base, 'Local State'), encoding='utf-8') as f:
            p = json.load(f).get('profile', {}).get('last_used')
        if p and os.path.isdir(os.path.join(base, p)):
            return os.path.join(base, p)
    except (OSError, ValueError):
        pass
    return os.path.join(base, 'Default')


def _copia(caminho):
    """Os bancos do navegador estão trancados enquanto ele está aberto: lê-se uma cópia."""
    d = tempfile.mkdtemp(prefix='carinaeos-fav-')
    destino = os.path.join(d, os.path.basename(caminho))
    shutil.copy2(caminho, destino)
    for ext in ('-wal', '-shm'):
        if os.path.exists(caminho + ext):
            shutil.copy2(caminho + ext, destino + ext)
    return d, destino


def _guardar_icone(url, dados):
    if not dados:
        return ''
    os.makedirs(CACHE, exist_ok=True)
    arq = os.path.join(CACHE, hashlib.md5(url.encode()).hexdigest() + '.png')
    try:
        with open(arq, 'wb') as f:
            f.write(dados)
        return arq
    except OSError:
        return ''


def _icones_chromium(perfil, urls):
    r = {}
    db = os.path.join(perfil, 'Favicons')
    if not urls or not os.path.isfile(db):
        return r
    d = None
    try:
        d, c = _copia(db)
        con = sqlite3.connect('file:%s?mode=ro' % c, uri=True)
        for u in urls:
            linha = con.execute(
                'SELECT b.image_data FROM icon_mapping m JOIN favicon_bitmaps b ON b.icon_id = m.icon_id '
                'WHERE m.page_url = ? ORDER BY (b.width >= 32) DESC, abs(b.width - 64) LIMIT 1', (u,)).fetchone()
            if not linha:      # a página guardada não tem ícone próprio: o do mesmo site
                base = u.split('/', 3)[:3]
                linha = con.execute(
                    'SELECT b.image_data FROM icon_mapping m JOIN favicon_bitmaps b ON b.icon_id = m.icon_id '
                    'WHERE m.page_url LIKE ? ORDER BY (b.width >= 32) DESC, abs(b.width - 64) LIMIT 1',
                    ('/'.join(base) + '/%',)).fetchone()
            if linha:
                r[u] = _guardar_icone(u, linha[0])
        con.close()
    except Exception:
        pass
    finally:
        if d:
            shutil.rmtree(d, ignore_errors=True)
    return r


def _nome_site(titulo, url, site):
    """O nome do site, não o da página: "Vídeo - YouTube" -> YouTube; github.com/leo -> Github."""
    import re
    partes = [p.strip() for p in re.split(r'\s+[-–—|·]\s+', titulo or '') if p.strip()]
    if len(partes) > 1:
        return partes[-1]
    caminho = url.split('/', 3)[3] if url.count('/') >= 3 else ''
    if titulo and not caminho.strip('/'):
        return titulo
    nome = site.split(':')[0]
    if re.fullmatch(r'[\d.]+', nome):
        return titulo or nome
    partes = nome.split('.')
    return (partes[-3] if len(partes) > 2 and partes[-2] in ('com', 'co', 'org', 'gov') else partes[-2] if len(partes) > 1 else nome).capitalize()


def mais_visitados_chromium(perfil, n=12):
    """Sem favoritos: os sites mais visitados (um por site), do histórico do navegador."""
    db = os.path.join(perfil, 'History')
    if not os.path.isfile(db):
        return []
    d = None
    try:
        d, c = _copia(db)
        con = sqlite3.connect('file:%s?mode=ro' % c, uri=True)
        vistos, r = set(), []
        for url, titulo in con.execute("SELECT url, title FROM urls WHERE hidden = 0 AND url LIKE 'http%' "
                                       'ORDER BY visit_count DESC, last_visit_time DESC LIMIT 300'):
            site = url.split('/', 3)[2].lower().removeprefix('www.')
            if site in vistos or site.startswith(('accounts.', 'login.')):
                continue
            vistos.add(site)
            base = '/'.join(url.split('/', 3)[:3]) + '/'
            nome = _nome_site(titulo, url, site)
            r.append(dict(tipo='site', nome=nome or site, url=base, icone='', _pagina=url))
            if len(r) >= n:
                break
        con.close()
        return r
    except Exception:
        return []
    finally:
        if d:
            shutil.rmtree(d, ignore_errors=True)


def _raizes(perfil):
    """Os favoritos do perfil e, se a sessão Google estiver ligada, os da conta (AccountBookmarks,
    Chrome 2025+): as barras juntam-se, sem repetidos."""
    raiz = None
    for arq in ('Bookmarks', 'AccountBookmarks'):
        try:
            with open(os.path.join(perfil, arq), encoding='utf-8') as f:
                r = json.load(f)['roots']
        except (OSError, ValueError, KeyError):
            continue
        if raiz is None:
            raiz = r
            continue
        for k in ('bookmark_bar', 'other'):
            urls = {c.get('url') for c in raiz.get(k, {}).get('children', []) if c.get('url')}
            raiz.setdefault(k, {}).setdefault('children', []).extend(
                c for c in r.get(k, {}).get('children', []) if not c.get('url') or c.get('url') not in urls)
    return raiz


def chromium(nome, base):
    perfil = _perfil_chromium(base)
    raiz = _raizes(perfil)
    if not raiz or not (raiz.get('bookmark_bar', {}).get('children') or raiz.get('other', {}).get('children')):
        if not os.path.isdir(perfil):
            return None
        topo = mais_visitados_chromium(perfil)
        ic = _icones_chromium(perfil, [x['_pagina'] for x in topo])
        for x in topo:
            x['icone'] = ic.get(x.pop('_pagina'), '')
        return dict(navegador=nome, titulo='Mais visitados no ' + nome, itens=topo, _perfil=perfil)
    urls = []

    def conv(n, nivel=0):
        if n.get('type') == 'url':
            urls.append(n.get('url', ''))
            return dict(tipo='site', nome=n.get('name') or n.get('url', ''), url=n.get('url', ''), icone='')
        if n.get('type') == 'folder' and nivel < 4:
            return dict(tipo='pasta', nome=n.get('name') or 'Pasta', itens=[x for x in (conv(c, nivel + 1) for c in n.get('children', [])[:MAX]) if x])
        return None
    barra = raiz.get('bookmark_bar', {}).get('children', [])
    itens = [x for x in (conv(c) for c in barra[:MAX]) if x]
    outros = raiz.get('other', {}).get('children', [])
    if outros:
        itens.append(dict(tipo='pasta', nome='Outros favoritos', itens=[x for x in (conv(c, 1) for c in outros[:MAX]) if x]))
    ic = _icones_chromium(perfil, urls)

    def por_icone(l):
        for x in l:
            if x['tipo'] == 'site':
                x['icone'] = ic.get(x['url'], '')
            else:
                por_icone(x['itens'])
    por_icone(itens)
    return dict(navegador=nome, titulo='Favoritos do ' + nome, itens=itens, _perfil=perfil)


def firefox():
    for base in FIREFOX:
        perfis = sorted(glob.glob(os.path.join(HOME, base, '*', 'places.sqlite')), key=os.path.getmtime, reverse=True)
        if not perfis:
            continue
        perfil = os.path.dirname(perfis[0])
        d = None
        try:
            d, c = _copia(os.path.join(perfil, 'places.sqlite'))
            con = sqlite3.connect('file:%s?mode=ro' % c, uri=True)
            barra = con.execute("SELECT id FROM moz_bookmarks WHERE guid = 'toolbar_____'").fetchone()
            urls = []

            def filhos(pai, nivel=0):
                r = []
                for ident, tipo, titulo, url in con.execute(
                        'SELECT b.id, b.type, b.title, p.url FROM moz_bookmarks b LEFT JOIN moz_places p ON p.id = b.fk '
                        'WHERE b.parent = ? ORDER BY b.position LIMIT ?', (pai, MAX)):
                    if tipo == 1 and url and not url.startswith('place:'):
                        urls.append(url)
                        r.append(dict(tipo='site', nome=titulo or url, url=url, icone=''))
                    elif tipo == 2 and nivel < 4:
                        r.append(dict(tipo='pasta', nome=titulo or 'Pasta', itens=filhos(ident, nivel + 1)))
                return r
            itens = filhos(barra[0]) if barra else []
            con.close()
            # ícones: favicons.sqlite
            fdb = os.path.join(perfil, 'favicons.sqlite')
            if os.path.isfile(fdb) and urls:
                d2, c2 = _copia(fdb)
                try:
                    con = sqlite3.connect('file:%s?mode=ro' % c2, uri=True)
                    ic = {}
                    for u in urls:
                        linha = con.execute(
                            'SELECT i.data FROM moz_pages_w_icons p JOIN moz_icons_to_pages t ON t.page_id = p.id '
                            'JOIN moz_icons i ON i.id = t.icon_id WHERE p.page_url = ? ORDER BY abs(i.width - 64) LIMIT 1', (u,)).fetchone()
                        if linha:
                            ic[u] = _guardar_icone(u, linha[0])
                    con.close()

                    def por_icone(l):
                        for x in l:
                            if x['tipo'] == 'site':
                                x['icone'] = ic.get(x['url'], '')
                            else:
                                por_icone(x['itens'])
                    por_icone(itens)
                finally:
                    shutil.rmtree(d2, ignore_errors=True)
            return dict(navegador='Firefox', titulo='Favoritos do Firefox', itens=itens)
        except Exception:
            continue
        finally:
            if d:
                shutil.rmtree(d, ignore_errors=True)
    return None


def favoritos():
    padrao = navegador_padrao()
    ordem = sorted(CHROMIUMS, key=lambda c: not any(p in padrao for p in c[1]))
    if 'firefox' in padrao:
        r = firefox()
        if r:
            return r
    for nome, _, pastas in ordem:
        for p in pastas:
            base = os.path.join(HOME, p)
            if os.path.isdir(base):
                r = chromium(nome, base)
                if r:
                    return r
    return firefox() or dict(navegador='', itens=[])


# ---- os sites do próprio Deck e os ocultos -------------------------------------------------------
def ler_deck():
    try:
        with open(DECK, encoding='utf-8') as f:
            d = json.load(f)
            return dict(sites=d.get('sites', []), ocultos=d.get('ocultos', []))
    except (OSError, ValueError):
        return dict(sites=[], ocultos=[])


def gravar_deck(d):
    os.makedirs(os.path.dirname(DECK), exist_ok=True)
    with open(DECK + '.tmp', 'w', encoding='utf-8') as f:
        json.dump(d, f, ensure_ascii=False, indent=1)
    os.replace(DECK + '.tmp', DECK)


def _url(u):
    u = (u or '').strip()
    if u and not re.match(r'^[a-z][a-z0-9+.-]*://', u, re.I):
        local = re.match(r'^(localhost|\d{1,3}(\.\d{1,3}){3}|[^/:]+\.local)([:/]|$)', u, re.I)
        u = ('http://' if local else 'https://') + u      # na rede de casa quase nunca há HTTPS
    m = re.match(r'^https?://([^\s/?#]+)[^\s]*$', u, re.I)
    host = m.group(1).split('@')[-1].split(':')[0].lower() if m else ''
    return u if host and ('.' in host or host == 'localhost') else ''


def tudo():
    r = favoritos()
    perfil = r.pop('_perfil', None)
    d = ler_deck()
    ocultos = set(d['ocultos'])

    def filtrar(l):
        out = []
        for x in l:
            if x['tipo'] == 'site' and x['url'] in ocultos:
                continue
            if x['tipo'] == 'pasta':
                x['itens'] = filtrar(x['itens'])
            out.append(x)
        return out
    r['itens'] = filtrar(r.get('itens', []))
    meus = [dict(tipo='site', nome=s['nome'], url=s['url'], icone='', meu=True) for s in d['sites']]
    if meus:
        ic = _icones_chromium(perfil, [m['url'] for m in meus]) if perfil else {}
        for m in meus:
            m['icone'] = ic.get(m['url'], '')
        urls = {m['url'] for m in meus}
        r['itens'] = meus + [x for x in r['itens'] if x.get('url') not in urls]
    r['ocultos'] = len(d['ocultos'])
    if not r.get('titulo'):
        r['titulo'] = 'Sites'
    return r


def main(a):
    if not a:
        print(json.dumps(tudo(), ensure_ascii=False))
        return 0
    d = ler_deck()
    if a[0] == 'adicionar' and len(a) >= 3:
        u = _url(a[2])
        if not u:
            print('endereço inválido', file=sys.stderr)
            return 2
        d['sites'] = [s for s in d['sites'] if s['url'] != u] + [dict(nome=a[1].strip() or u, url=u)]
        d['ocultos'] = [o for o in d['ocultos'] if o != u]
    elif a[0] == 'editar' and len(a) >= 4:
        u = _url(a[3])
        if not u:
            return 2
        for s in d['sites']:
            if s['url'] == a[1]:
                s['nome'], s['url'] = a[2].strip() or u, u
                break
        else:       # um favorito do navegador: passa a ser um site do Deck (e o original fica oculto)
            d['sites'].append(dict(nome=a[2].strip() or u, url=u))
            if a[1] not in d['ocultos'] and a[1] != u:
                d['ocultos'].append(a[1])
    elif a[0] == 'remover' and len(a) >= 2:
        antes = len(d['sites'])
        d['sites'] = [s for s in d['sites'] if s['url'] != a[1]]
        if len(d['sites']) == antes and a[1] not in d['ocultos']:
            d['ocultos'].append(a[1])
    elif a[0] == 'mostrar-todos':
        d['ocultos'] = []
    else:
        print(__doc__)
        return 1
    gravar_deck(d)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
