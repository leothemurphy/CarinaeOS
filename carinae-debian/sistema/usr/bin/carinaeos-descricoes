CATEGORIAS = [   # da mais específica para a mais geral
    ('WebBrowser', 'Navegador da internet'), ('Email', 'E-mail'), ('InstantMessaging', 'Mensagens e conversas'),
    ('Chat', 'Mensagens e conversas'), ('VideoConference', 'Videochamadas'), ('FileTransfer', 'Baixar e enviar arquivos'),
    ('WordProcessor', 'Editor de textos'), ('Spreadsheet', 'Planilhas'), ('Presentation', 'Apresentações'),
    ('Calendar', 'Calendário'), ('ContactManagement', 'Contatos'), ('Viewer', 'Ver documentos e imagens'),
    ('TextEditor', 'Editor de texto'), ('IDE', 'Programação'), ('Development', 'Programação'),
    ('3DGraphics', 'Gráficos 3D'), ('Photography', 'Fotografia'), ('RasterGraphics', 'Editar imagens'),
    ('VectorGraphics', 'Desenho vetorial'), ('Scanning', 'Digitalizar'), ('Graphics', 'Imagens e desenho'),
    ('Player', 'Tocar música e vídeo'), ('Recorder', 'Gravar som e vídeo'), ('AudioVideoEditing', 'Editar áudio e vídeo'),
    ('Music', 'Música'), ('Video', 'Vídeo'), ('AudioVideo', 'Música e vídeo'), ('Audio', 'Som'),
    ('Game', 'Jogo'), ('Education', 'Educação'), ('Science', 'Ciência'), ('Maps', 'Mapas'),
    ('Finance', 'Finanças'), ('Office', 'Escritório'), ('Archiving', 'Arquivos compactados'),
    ('FileManager', 'Arquivos e pastas'), ('TerminalEmulator', 'Terminal'), ('Monitor', 'Monitorar o sistema'),
    ('Security', 'Segurança'), ('Settings', 'Configurações'), ('PackageManager', 'Instalar aplicativos'),
    ('System', 'Ferramenta do sistema'), ('Accessibility', 'Acessibilidade'), ('Utility', 'Utilitário'),
    ('Network', 'Internet'),
]


def ler_desktop(f):
    c = configparser.RawConfigParser(strict=False, interpolation=None)
    c.optionxform = str
    try:
        c.read(f, encoding='utf-8')
        return dict(c['Desktop Entry']) if c.has_section('Desktop Entry') else None
    except (configparser.Error, UnicodeDecodeError, OSError):
        return None


def frase(id_, d):
    nome = (d.get('Name[pt_BR]') or d.get('Name') or '').strip()
    for k in (id_, id_.lower(), nome.lower()):
        if k in MAO:
            return MAO[k]
    for k in ('Comment[pt_BR]', 'Comment[pt]', 'GenericName[pt_BR]', 'GenericName[pt]'):
        v = (d.get(k) or '').strip()
        if v:
            return v
    cats = set((d.get('Categories') or '').split(';'))
    for c, t in CATEGORIAS:
        if c in cats:
            return t
    return (d.get('Comment') or d.get('GenericName') or '').strip()


def assinatura():
    return [round(os.path.getmtime(p)) if os.path.isdir(p) else 0 for p in PASTAS]


def main():
    sig = assinatura()
    try:
        with open(CACHE, encoding='utf-8') as f:
            c = json.load(f)
        if c.get('sig') == sig and c.get('versao') == 2:
            sys.stdout.write(json.dumps(c['d'], ensure_ascii=True))
            return 0
    except (OSError, ValueError, KeyError):
        pass
    r = {}
    for p in reversed(PASTAS):           # os do usuário ficam por cima
        for f in glob.glob(os.path.join(p, '*.desktop')):
            d = ler_desktop(f)
            if not d or d.get('NoDisplay', '').lower() == 'true':
                continue
            base = os.path.basename(f)
            t = frase(base[:-8], d)
            if t:
                r[base] = t
                nome = (d.get('Name[pt_BR]') or d.get('Name') or '').strip().lower()
                if nome:
                    r['nome:' + nome] = t
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE, 'w', encoding='utf-8') as f:
            json.dump(dict(sig=sig, versao=2, d=r), f, ensure_ascii=False)
    except OSError:
        pass
    sys.stdout.write(json.dumps(r, ensure_ascii=True))
    return 0


if __name__ == '__main__':
    sys.exit(main())
