#!/bin/sh
# CarinaeOS - Ceu vivo: o fundo de Eta Carinae muda de tom com a hora do dia
H=$(date +%H)
if   [ "$H" -ge 5 ]  && [ "$H" -lt 8 ];  then V=madrugada
elif [ "$H" -ge 8 ]  && [ "$H" -lt 16 ]; then V=manha
elif [ "$H" -ge 16 ] && [ "$H" -lt 20 ]; then V=tarde
else V=noite; fi
E="${XDG_CACHE_HOME:-$HOME/.cache}/carinaeos-ceu-vivo"
[ "$(cat "$E" 2>/dev/null)" = "$V" ] && [ "$1" != "--forcar" ] && exit 0
plasma-apply-wallpaperimage "/usr/share/carinaeos/ceu/$V.jpg" >/dev/null 2>&1 && { mkdir -p "$(dirname "$E")"; echo "$V" > "$E"; }
