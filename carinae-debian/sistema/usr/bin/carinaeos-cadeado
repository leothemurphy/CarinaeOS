#!/usr/bin/python3
"""CarinaeOS - Cadeado: trancar pastas, arquivos e aplicativos com senha.

  carinaeos-cadeado trancar <pastas ou arquivos...>
  carinaeos-cadeado abrir <trancado...>          (duplo clique)
  carinaeos-cadeado aplicativos                  (escolher apps que pedem senha)
  carinaeos-cadeado abrir-app <id.desktop> [args]

Uma pasta trancada fica no mesmo sitio e com o mesmo nome, com o icone de pasta com
cadeado; so abre com a senha (duplo clique). Por dentro e um arquivo cifrado com GnuPG
(AES-256): sem a senha, o conteudo nao se le de nenhuma maneira. O original so e apagado
depois de o trancado ser criado e verificado. Arquivos ficam "nome.ext.trancado".
"""
import configparser, hashlib, hmac, json, os, shlex, shutil, subprocess, sys, tarfile, tempfile

CONF = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'carinaeos-cadeado.json')
LOCAL_APPS = os.path.join(os.environ.get('XDG_DATA_HOME', os.path.expanduser('~/.local/share')), 'applications')
TITULO = 'Cadeado do CarinaeOS'
EXT = '.trancado'
CAB_PASTA = b'CARINAEOS-PASTA1\n'
CAB_ARQUI = b'CARINAEOS-ARQUI1\n'
ANTIGO_EXT = '.bloqueado'
ANTIGO_CONTEUDO = 'Conteúdo bloqueado.bloqueado'


def pedir_senha(titulo, mensagem='', erro='', nova=False, botao='Continuar'):
    args = ['carinaeos-pedir-senha', '--titulo', titulo, '--mensagem', mensagem, '--botao', botao]
    if erro:
        args += ['--erro', erro]
    if nova:
        args.append('--nova')
    try:
        r = subprocess.run(args, capture_output=True, text=True)
    except FileNotFoundError:
        r = subprocess.run(['kdialog', '--title', TITULO, '--password', titulo + '\n' + mensagem], capture_output=True, text=True)
        return r.stdout.rstrip('\n') if r.returncode == 0 and r.stdout.strip() else None
    return r.stdout if r.returncode == 0 and r.stdout else None


def nova_senha(titulo, mensagem=''):
    return pedir_senha(titulo, mensagem, nova=True, botao='Trancar')


def avisar(titulo, texto='', icone='object-locked', acoes=None):
    """Notificacao; acoes=[(id, rotulo)] devolve o id escolhido (ou None)."""
    args = ['notify-send', '-a', 'Cadeado', '-i', icone, titulo, texto]
    for i, r in (acoes or []):
        args[1:1] = ['-A', '%s=%s' % (i, r)]
    if acoes:
        args.insert(1, '--wait')
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=600 if acoes else 10)
        return r.stdout.strip() or None
    except Exception:
        return None


def erro(msg):
    avisar('Cadeado', msg, 'dialog-error')


def aviso(msg):
    avisar('Cadeado', msg)


# ---- configuracao (senha de aplicativos + lista de apps bloqueados) ---------
def ler_conf():
    try:
        with open(CONF) as f:
            return json.load(f)
    except Exception:
        return {'apps': []}


def gravar_conf(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + '.tmp'
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as f:
        json.dump(c, f, indent=1)
    os.replace(tmp, CONF)


def hash_senha(senha, sal):
    return hashlib.pbkdf2_hmac('sha256', senha.encode(), bytes.fromhex(sal), 300000).hex()


def senha_certa(c, senha):
    return 'sal' in c and hmac.compare_digest(hash_senha(senha, c['sal']), c.get('hash', ''))


# ---- pastas e arquivos ----------------------------------------------------------
def gpg(args, senha, entrada=None):
    r, w = os.pipe()
    os.write(w, (senha + '\n').encode())
    os.close(w)
    try:
        return subprocess.run(['gpg', '--batch', '--yes', '--quiet', '--no-symkey-cache', '--pinentry-mode', 'loopback',
                               '--passphrase-fd', str(r), *args], pass_fds=(r,), stdin=entrada, capture_output=True)
    finally:
        os.close(r)


def cabecalho(p):
    try:
        with open(p, 'rb') as f:
            return f.read(len(CAB_PASTA))
    except OSError:
        return b''


def e_trancado(p):
    return os.path.isfile(p) and cabecalho(p) in (CAB_PASTA, CAB_ARQUI)


def trancar_um(p, senha):
    pai, nome = os.path.split(p)
    pasta = os.path.isdir(p) and not os.path.islink(p)
    final = p if pasta else p + EXT
    if not pasta and os.path.exists(final):
        raise RuntimeError('já existe "%s"' % os.path.basename(final))
    tmp = os.path.join(pai, '.%s.a-trancar' % nome)
    with tempfile.TemporaryDirectory(dir=pai if os.access(pai, os.W_OK) else None) as t:
        pacote = os.path.join(t, 'c.tar')
        with tarfile.open(pacote, 'w') as tar:
            tar.add(p, arcname=nome)
        cif = os.path.join(t, 'c.gpg')
        r = gpg(['--symmetric', '--cipher-algo', 'AES256', '-o', cif, pacote], senha)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.decode(errors='ignore').strip() or 'gpg falhou')
        os.remove(pacote)
        with open(cif, 'rb') as f:
            r = gpg(['-o', os.path.join(t, 'v.tar'), '-d'], senha, entrada=f)     # verificar antes de apagar
        if r.returncode != 0:
            raise RuntimeError('a verificação falhou; nada foi apagado')
        os.remove(os.path.join(t, 'v.tar'))
        with open(tmp, 'wb') as o, open(cif, 'rb') as f:
            o.write(CAB_PASTA if pasta else CAB_ARQUI)
            shutil.copyfileobj(f, o, 1 << 20)
    if pasta:
        velho = os.path.join(pai, '.%s.a-apagar' % nome)
        os.rename(p, velho)
        os.rename(tmp, final)
        shutil.rmtree(velho, ignore_errors=True)
    else:
        os.rename(tmp, final)
        os.remove(p)
    return final


def trancar(caminhos):
    caminhos = [os.path.abspath(p).rstrip('/') for p in caminhos]
    caminhos = [p for p in caminhos if os.path.exists(p) and not e_trancado(p) and not p.endswith(ANTIGO_EXT)]
    if not caminhos:
        aviso('Isso já está trancado.')
        return
    nomes = ', '.join('“%s”' % os.path.basename(p) for p in caminhos[:4]) + ('…' if len(caminhos) > 4 else '')
    senha = nova_senha('Trancar %s' % nomes,
                       'Escolha uma senha. Sem ela, ninguém consegue abrir — nem você: guarde-a bem.')
    if senha is None:
        return
    falhas, feitos = [], []
    for p in caminhos:
        try:
            feitos.append(trancar_um(p, senha))
        except Exception as e:
            falhas.append('%s: %s' % (os.path.basename(p), e))
    if feitos:
        avisar('Trancado ✓', '%s só abre com a senha (duplo clique).' % nomes)
    if falhas:
        erro('Não foi possível trancar:\n' + '\n'.join(falhas))


def abrir_um(p, senha):
    """Decifra; devolve o caminho do que ficou aberto. Levanta ValueError se a senha estiver errada."""
    pai = os.path.dirname(p)
    cab = cabecalho(p)
    pasta = cab == CAB_PASTA
    with tempfile.TemporaryDirectory(dir=pai if os.access(pai, os.W_OK) else None) as t:
        pacote = os.path.join(t, 'c.tar')
        with open(p, 'rb', buffering=0) as f:
            f.read(len(cab))
            r = gpg(['-o', pacote, '-d'], senha, entrada=f)
        if r.returncode != 0:
            raise ValueError('senha')
        saida = os.path.join(t, 'x')
        os.mkdir(saida)
        with tarfile.open(pacote) as tar:
            nomes = tar.getnames()
            if any(n.startswith('/') or '..' in n.split('/') for n in nomes) or len({n.split('/')[0] for n in nomes}) != 1:
                raise RuntimeError('conteúdo inválido')
            tar.extractall(saida, filter='data')
        nome = os.listdir(saida)[0]
        if pasta:
            destino = p                       # a pasta volta a ter o nome do trancado
            os.remove(p)
            os.rename(os.path.join(saida, nome), destino)
        else:
            destino = os.path.join(pai, nome)
            if os.path.exists(destino):
                raise RuntimeError('já existe "%s"' % nome)
            os.rename(os.path.join(saida, nome), destino)
            os.remove(p)
    return destino


def abrir_antigo(p, senha):
    """Formato do rc7 (.bloqueado e 'Conteudo bloqueado.bloqueado' dentro da pasta)."""
    pasta = os.path.dirname(p)
    dentro = os.path.basename(p) == ANTIGO_CONTEUDO
    with tempfile.TemporaryDirectory() as t:
        pacote = os.path.join(t, 'c.tar')
        r = gpg(['-o', pacote, '-d', p], senha)
        if r.returncode != 0:
            raise ValueError('senha')
        with tarfile.open(pacote) as tar:
            nomes = tar.getnames()
            if any(n.startswith('/') or '..' in n.split('/') for n in nomes):
                raise RuntimeError('conteúdo inválido')
            tar.extractall(pasta, filter='data')
    os.remove(p)
    if dentro:
        for d in ('.directory', '.directory.antes-do-cadeado'):
            f = os.path.join(pasta, d)
            if d == '.directory' and os.path.exists(f + '.antes-do-cadeado'):
                continue
            if os.path.exists(f):
                os.replace(f, os.path.join(pasta, '.directory')) if d.endswith('cadeado') else os.remove(f)
        return pasta
    return p[:-len(ANTIGO_EXT)]


def abrir(caminhos):
    alvos = []
    for p in caminhos:
        p = os.path.abspath(p).rstrip('/')
        if e_trancado(p) or (p.endswith(ANTIGO_EXT) and os.path.isfile(p)):
            alvos.append(p)
        elif os.path.isdir(p) and os.path.isfile(os.path.join(p, ANTIGO_CONTEUDO)):
            alvos.append(os.path.join(p, ANTIGO_CONTEUDO))
    if not alvos:
        aviso('Não há nada trancado aqui.')
        return
    for p in alvos:
        nome = os.path.basename(os.path.dirname(p) if os.path.basename(p) == ANTIGO_CONTEUDO else p)
        if nome.endswith(EXT):
            nome = nome[:-len(EXT)]
        e = ''
        for _tentativa in range(5):
            senha = pedir_senha('Abrir “%s”' % nome, 'Esta %s está trancada. Digite a senha para a abrir.'
                                % ('pasta' if cabecalho(p) == CAB_PASTA or p.endswith(ANTIGO_CONTEUDO) else 'arquivo'),
                                erro=e, botao='Abrir')
            if senha is None:
                return
            try:
                f = abrir_antigo(p, senha) if (p.endswith(ANTIGO_EXT)) else abrir_um(p, senha)
            except ValueError:
                e = 'Senha incorreta. Tente outra vez.'
                continue
            except Exception as x:
                erro('Não foi possível abrir “%s”: %s' % (nome, x))
                return
            subprocess.Popen(['xdg-open', f], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.fork() == 0:              # oferecer trancar de novo, sem prender o duplo clique
                os.setsid()
                if avisar('“%s” está aberta' % nome, 'Quando acabar, tranque-a de novo.', 'object-unlocked',
                          acoes=[('trancar', 'Trancar de novo')]) == 'trancar':
                    trancar([f])
                os._exit(0)
            break


# ---- aplicativos -------------------------------------------------------------
def pastas_sistema():
    dirs = os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':')
    return [os.path.join(d, 'applications') for d in dirs if d]


def desktop_sistema(app_id):
    for d in pastas_sistema():
        f = os.path.join(d, app_id)
        if os.path.isfile(f):
            return f
    return None


def ler_desktop(f):
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(f, encoding='utf-8')
    return cp


def apps_instalados():
    vistos = {}
    for d in reversed(pastas_sistema()):
        if not os.path.isdir(d):
            continue
        for n in os.listdir(d):
            if not n.endswith('.desktop'):
                continue
            cp = ler_desktop(os.path.join(d, n))
            if not cp.has_section('Desktop Entry'):
                continue
            e = cp['Desktop Entry']
            if e.get('Type') != 'Application' or e.get('NoDisplay') == 'true' or e.get('Hidden') == 'true':
                continue
            nome = e.get('Name[pt_BR]') or e.get('Name')
            if nome and n != 'carinaeos-bloquear-apps.desktop':
                vistos[n] = nome
    return sorted(vistos.items(), key=lambda x: x[1].lower())


def aplicar_bloqueios(c):
    os.makedirs(LOCAL_APPS, exist_ok=True)
    for n in os.listdir(LOCAL_APPS):
        f = os.path.join(LOCAL_APPS, n)
        try:
            if 'X-CarinaeOS-Cadeado=true' in open(f, encoding='utf-8').read() and n not in c['apps']:
                os.remove(f)
        except Exception:
            pass
    for app_id in c['apps']:
        orig = desktop_sistema(app_id)
        if not orig:
            continue
        linhas = open(orig, encoding='utf-8').read().splitlines()
        saida, secao = [], ''
        for l in linhas:
            if l.startswith('['):
                secao = l.strip()
            if l.startswith('Exec=') or l.startswith('TryExec='):
                if l.startswith('TryExec='):
                    continue
                exec_orig = l[5:]
                codigos = ' '.join(c2 for c2 in ('%U', '%u', '%F', '%f') if c2 in exec_orig)
                l = 'Exec=carinaeos-cadeado abrir-app %s %s' % (app_id, codigos)
            saida.append(l)
            if l.strip() == '[Desktop Entry]':
                saida.append('X-CarinaeOS-Cadeado=true')
        with open(os.path.join(LOCAL_APPS, app_id), 'w', encoding='utf-8') as f:
            f.write('\n'.join(saida) + '\n')
    if shutil.which('kbuildsycoca6'):
        subprocess.run(['kbuildsycoca6'], capture_output=True)


def escolher_apps(lista):
    """lista = [id, nome, on/off, ...] -> ids marcados (ou None se cancelou)."""
    if shutil.which('kdialog'):
        r = subprocess.run(['kdialog', '--title', TITULO, '--separate-output', '--geometry', '520x620', '--checklist',
                            'Marque os aplicativos que devem pedir senha para abrir:', *lista], capture_output=True, text=True)
        return [l for l in r.stdout.splitlines() if l] if r.returncode == 0 else None
    if shutil.which('zenity'):
        linhas = []
        for i in range(0, len(lista), 3):
            linhas += ['TRUE' if lista[i + 2] == 'on' else 'FALSE', lista[i], lista[i + 1]]
        r = subprocess.run(['zenity', '--list', '--checklist', '--title', TITULO, '--width', '520', '--height', '620',
                            '--text', 'Marque os aplicativos que devem pedir senha para abrir:', '--column', '',
                            '--column', 'id', '--column', 'Aplicativo', '--hide-column', '2', '--print-column', '2',
                            '--separator', '\n', *linhas], capture_output=True, text=True)
        return [l for l in r.stdout.splitlines() if l] if r.returncode == 0 else None
    erro('Falta o kdialog ou o zenity para escolher os aplicativos.')
    return None


def gerir_apps():
    c = ler_conf()
    if 'sal' not in c:
        s = nova_senha('Senha dos aplicativos trancados', 'Esta senha vai ser pedida sempre que abrir um aplicativo trancado.')
        if s is None:
            return
        c['sal'] = os.urandom(16).hex()
        c['hash'] = hash_senha(s, c['sal'])
        gravar_conf(c)
    else:
        e = ''
        while True:
            s = pedir_senha('Aplicativos trancados', 'Digite a senha dos aplicativos.', erro=e)
            if s is None:
                return
            if senha_certa(c, s):
                break
            e = 'Senha incorreta.'
    lista = []
    for app_id, nome in apps_instalados():
        lista += [app_id, nome, 'on' if app_id in c['apps'] else 'off']
    out = escolher_apps(lista)
    if out is None:
        return
    c['apps'] = out
    gravar_conf(c)
    aplicar_bloqueios(c)
    aviso('Pronto. %d aplicativo(s) bloqueado(s).' % len(c['apps']))


def abrir_app(app_id, args):
    c = ler_conf()
    orig = desktop_sistema(app_id)
    if not orig:
        erro('Aplicativo não encontrado: ' + app_id)
        return 1
    e = ler_desktop(orig)['Desktop Entry']
    nome = e.get('Name[pt_BR]') or e.get('Name') or app_id
    if app_id in c.get('apps', []):
        e = ''
        while True:
            s = pedir_senha('Abrir “%s”' % nome, 'Este aplicativo está trancado. Digite a senha dos aplicativos.', erro=e, botao='Abrir')
            if s is None:
                return 1
            if senha_certa(c, s):
                break
            e = 'Senha incorreta.'
    cmd = []
    for p in shlex.split(e.get('Exec', '')):
        if p in ('%U', '%F'):
            cmd += args
        elif p in ('%u', '%f'):
            cmd += args[:1]
        elif p.startswith('%') and len(p) == 2:
            continue
        else:
            cmd.append(p.replace('%%', '%'))
    if not cmd:
        return 1
    os.execvp(cmd[0], cmd)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    acao, resto = sys.argv[1], sys.argv[2:]
    if acao in ('trancar', 'bloquear'):
        trancar(resto)
    elif acao in ('abrir', 'desbloquear', 'destrancar'):
        abrir(resto)
    elif acao == 'aplicativos':
        gerir_apps()
    elif acao == 'abrir-app' and resto:
        return abrir_app(resto[0], resto[1:])
    else:
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
